{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "热点采集快照",
  "type": "object",
  "required": ["generated_at", "rule_version", "window_days", "entries"],
  "properties": {
    "generated_at": { "type": "string" },
    "rule_version": { "type": "string" },
    "window_days": { "type": "integer", "minimum": 1 },
    "topics": { "type": "array", "items": { "type": "string" } },
    "domains": { "type": "array", "items": { "type": "string" } },
    "lanes": { "type": "array", "items": { "type": "string" } },
    "min_stars": { "type": "integer" },
    "new_min_stars": { "type": "integer" },
    "query_count": { "type": "integer" },
    "trend_basis": { "type": "string" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entry_id", "full_name", "html_url", "stars", "stars_gained"],
        "properties": {
          "entry_id": { "type": "string" },
          "full_name": { "type": "string" },
          "html_url": { "type": "string" },
          "description": { "type": "string" },
          "language": { "type": "string" },
          "stars": { "type": "integer" },
          "stars_gained": { "type": "integer" },
          "topics": { "type": "array", "items": { "type": "string" } },
          "first_seen": { "type": "string" },
          "rank_delta": { "type": "integer" },
          "is_new": { "type": "boolean" },
          "forks": { "type": "integer" },
          "open_issues": { "type": "integer" },
          "pushed_at": { "type": "string" },
          "license": { "type": "string" },
          "homepage": { "type": "string" },
          "archived": { "type": "boolean" },
          "domains": { "type": "array", "items": { "type": "string" } },
          "lanes": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "rate_limit": {
      "type": "object",
      "properties": {
        "remaining": { "type": "integer" },
        "resets_at": { "type": "string" },
        "authenticated": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
