{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "素材择优建议",
  "type": "object",
  "required": ["picks", "concerns", "summary"],
  "properties": {
    "picks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "usage", "score"],
        "properties": {
          "path": { "type": "string" },
          "style_id": { "type": "string" },
          "usage": { "type": "string" },
          "score": { "type": "string", "enum": ["high", "medium", "low"] },
          "reason": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "concerns": {
      "type": "array",
      "items": { "type": "string" }
    },
    "summary": { "type": "string" }
  },
  "additionalProperties": true
}
