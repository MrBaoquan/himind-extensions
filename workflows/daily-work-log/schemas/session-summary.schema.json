{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI 工作总结结果",
  "type": "object",
  "required": ["entries"],
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "session_id", "title"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "session_id": {"type": "string", "minLength": 1},
          "date": {"type": "string", "description": "会话活动日 YYYY-MM-DD，原样回带自素材；带上后可与确定性素材按「来源+会话+日期」精确合并"},
          "project": {"type": "string"},
          "feature": {"type": "string", "maxLength": 40},
          "exhibit": {"type": "string", "maxLength": 40, "description": "项目下的具体展项；判定不了就留空"},
          "category": {"type": "string", "enum": ["开发", "修复", "设计", "调研", "文档", "评审", "会议", "运维", "其他"], "description": "受控工作类型（中文枚举）；不确定时用「其他」"},
          "title": {"type": "string", "minLength": 1, "maxLength": 60},
          "summary": {"type": "string", "maxLength": 600, "description": "必填：1-3 句中文概括，不容省略"},
          "outcomes": {"type": "array", "items": {"type": "string", "maxLength": 300}},
          "decisions": {"type": "array", "items": {"type": "string", "maxLength": 300}},
          "learnings": {"type": "array", "items": {"type": "string", "maxLength": 300}},
          "blockers": {"type": "array", "items": {"type": "string", "maxLength": 300}},
          "next": {"type": "array", "items": {"type": "string", "maxLength": 300}}
        },
        "additionalProperties": true
      }
    },
    "narrative": {"type": "string", "maxLength": 800}
  },
  "additionalProperties": true
}
