{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "工作日志日报渲染结果",
  "type": "object",
  "required": [
    "report"
  ],
  "properties": {
    "report": {
      "type": "object",
      "required": [
        "period",
        "key",
        "markdown"
      ],
      "properties": {
        "period": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "period_key": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "include_children": {
          "type": "boolean"
        },
        "title": {
          "type": "string"
        },
        "date_from": {
          "type": "string"
        },
        "date_to": {
          "type": "string"
        },
        "entry_count": {
          "type": "integer"
        },
        "total_minutes": {
          "type": "integer"
        },
        "measured_minutes": {
          "type": "integer"
        },
        "estimated_minutes": {
          "type": "integer"
        },
        "activity_metrics": {
          "type": "object",
          "required": [
            "coverage_minutes",
            "session_minutes",
            "unknown_sessions",
            "manual_minutes"
          ],
          "properties": {
            "coverage_minutes": {
              "type": "integer",
              "minimum": 0
            },
            "session_minutes": {
              "type": "integer",
              "minimum": 0
            },
            "unknown_sessions": {
              "type": "integer",
              "minimum": 0
            },
            "manual_minutes": {
              "type": "integer",
              "minimum": 0
            },
            "execution_minutes": {
              "type": "integer",
              "minimum": 0
            },
            "execution_coverage_minutes": {
              "type": "integer",
              "minimum": 0
            },
            "execution_sessions": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "narrative_used": {
          "type": "boolean"
        },
        "md_path": {
          "type": "string"
        },
        "html_path": {
          "type": "string"
        },
        "markdown": {
          "type": "string"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
