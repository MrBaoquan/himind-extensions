{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "sessions",
    "omitted_count"
  ],
  "properties": {
    "sessions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "source",
          "session_id",
          "date"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "session_id": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "project": {
            "type": "string",
            "maxLength": 32
          },
          "title": {
            "type": "string",
            "maxLength": 48
          },
          "request": {
            "type": "string",
            "maxLength": 360
          },
          "result": {
            "type": "string",
            "maxLength": 140
          }
        },
        "additionalProperties": false
      }
    },
    "omitted_count": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
