{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WeChat Mini Program Acceptance Report",
  "type": "object",
  "required": [
    "schema_version",
    "candidate_id",
    "commit_sha",
    "tree_digest",
    "tester",
    "passed",
    "evidence_paths"
  ],
  "properties": {
    "schema_version": { "const": "wechat_acceptance_report.v1" },
    "candidate_id": { "type": "string", "minLength": 1 },
    "commit_sha": { "type": "string", "minLength": 1 },
    "tree_digest": { "type": "string", "minLength": 1 },
    "tester": { "type": "string", "minLength": 1 },
    "passed": { "type": "boolean" },
    "evidence_paths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "notes": { "type": "string" }
  }
}
