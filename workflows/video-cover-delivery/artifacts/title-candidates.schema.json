{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "himind.cover-title-candidates.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "facts", "candidates", "recommended_id"],
  "properties": {
    "schema_version": {"const": 1},
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "event", "local_relevance"],
      "properties": {
        "subject": {"type": "string"},
        "event": {"type": "string"},
        "when_where": {"type": "string"},
        "key_numbers": {"type": "array", "items": {"type": "string"}, "maxItems": 5},
        "local_relevance": {"type": "string"},
        "verified_quotes": {"type": "array", "items": {"type": "string"}, "maxItems": 5},
        "uncertainties": {"type": "array", "items": {"type": "string"}, "maxItems": 8}
      }
    },
    "candidates": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "type", "main", "sub", "main_lines", "sub_lines", "layout_hint", "why", "risk_flags"],
        "properties": {
          "id": {"enum": ["A", "B", "C", "D", "E", "F"]},
          "type": {"enum": ["fact", "contrast", "benefit", "human"]},
          "main": {"type": "string", "minLength": 4, "maxLength": 30},
          "sub": {"type": "string", "maxLength": 40},
          "main_lines": {"type": "array", "items": {"type": "string"}, "minItems": 1, "maxItems": 2},
          "sub_lines": {"type": "array", "items": {"type": "string"}, "minItems": 0, "maxItems": 1},
          "layout_hint": {"enum": ["short", "normal", "long"]},
          "why": {"type": "string", "maxLength": 120},
          "risk_flags": {"type": "array", "items": {"type": "string"}, "maxItems": 5}
        }
      }
    },
    "recommended_id": {"enum": ["A", "B", "C", "D", "E", "F"]},
    "recommend_reason": {"type": "string", "maxLength": 200}
  }
}
