{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "himind.video-cover-delivery.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "video_path",
    "selected_time_ms",
    "source_frame",
    "copy",
    "template_id",
    "outputs",
    "preview_path",
    "quality"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "video_path": {
      "type": "string",
      "minLength": 1
    },
    "selected_time_ms": {
      "type": "integer",
      "minimum": 0
    },
    "source_frame": {
      "type": "string",
      "minLength": 1
    },
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "main",
        "sub",
        "main_lines",
        "sub_lines",
        "layout_hint"
      ],
      "properties": {
        "main": {
          "type": "string",
          "minLength": 4,
          "maxLength": 30
        },
        "sub": {
          "type": "string",
          "maxLength": 40
        },
        "main_lines": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 2
        },
        "sub_lines": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0,
          "maxItems": 1
        },
        "layout_hint": {
          "enum": [
            "short",
            "normal",
            "long"
          ]
        }
      }
    },
    "template_id": {
      "const": "wanmei-d-v1"
    },
    "preview_path": {
      "type": "string",
      "minLength": 1
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "width",
          "height",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "title_safe_score",
        "title_lines",
        "detail_lines"
      ],
      "properties": {
        "title_safe_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "title_lines": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "detail_lines": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        }
      }
    }
  }
}
