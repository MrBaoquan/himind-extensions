{
  "schema_version": "workflow_package.v1",
  "id": "com.himind.workflow.wechat-experience-upload",
  "version": "1.2.4",
  "distribution_targets": ["workbench", "github"],
  "name": "微信小程序体验版上传",
  "description": "选择项目和展馆、指定开发或生产环境，可选通过 DSH 完成功能或 Bug 修复，构建后上传微信体验版。",
  "min_agent_version": "0.3.47",
  "local_requirements": {
    "platform": "windows",
    "workspace": "git",
    "required_tools": [
      "node",
      "npm",
      "git"
    ],
    "recommended_tools": [
      "miniprogram-ci"
    ]
  },
  "candidate": {
    "required": true,
    "artifact_id": "candidate",
    "source": "git",
    "allow_dirty": true
  },
  "execution_policy": "segmented",
  "entrypoints": [
    {
      "id": "develop",
      "at_step": "DEV-LOOP",
      "label": "开发与修复",
      "requires": ["project", "workspace"]
    },
    {
      "id": "build",
      "at_step": "WX-BUILD",
      "label": "构建交付候选",
      "requires": [
        "project",
        "workspace",
        "source_root",
        "project_root",
        "development_checkpoint"
      ]
    },
    {
      "id": "upload",
      "at_step": "WX-UPLOAD",
      "label": "上传已有候选",
      "requires": ["candidate", "readiness", "approval"]
    }
  ],
  "exits": [
    {
      "id": "development_checkpoint",
      "at_step": "DEV-LOOP",
      "label": "完成开发迭代",
      "produces": ["development_checkpoint"]
    },
    {
      "id": "candidate_ready",
      "at_step": "WX-CANDIDATE",
      "label": "候选已冻结",
      "produces": ["candidate"]
    },
    {
      "id": "experience_version",
      "at_step": "WX-UPLOAD",
      "label": "体验版已上传",
      "produces": ["experience_version"]
    }
  ],
  "capabilities": [
    "workflow.candidate.freeze",
    "wechat.miniprogram.build",
    "wechat.miniprogram.ci.readiness",
    "wechat.miniprogram.upload"
  ],
  "dependencies": {
    "skills": [],
    "plugins": [
      "com.himind.wechat-miniprogram-tools"
    ],
    "connectors": [
      "wechat-miniprogram"
    ],
    "runtimes": [
      "himind.builtin"
    ]
  },
  "steps": [
    {
      "id": "DEV-LOOP",
      "title": "DSH 开发与修复",
      "kind": "loop",
      "execution_mode": "long_running",
      "risk_level": "local_write",
      "when": {
        "operator": "equals",
        "path": "input.development_requested",
        "value": true
      },
      "loop": {
        "max_iterations": 3,
        "pause_for_feedback": true,
        "continue_when": {
          "operator": "not_equals",
          "path": "loops.DEV-LOOP.latest.steps.DEV-REVIEW.feedback.decision",
          "value": "accepted"
        },
        "exit_when": {
          "operator": "equals",
          "path": "loops.DEV-LOOP.latest.steps.DEV-REVIEW.feedback.decision",
          "value": "accepted"
        },
        "steps": [
          {
            "id": "DEV-CODE",
            "title": "DSH 修改代码",
            "kind": "runtime",
            "execution_mode": "long_running",
            "risk_level": "local_write",
            "runtime": {
              "provider": "himind.builtin",
              "prompt": "你是微信小程序工程的开发 Agent。根据需求、验收标准、约束、当前代码和用户反馈完成功能开发或 Bug 修复。必须保持项目现有展馆、环境、构建脚本和代码风格。优先运行与改动直接相关的测试或构建检查。不得读取、输出、写入或猜测任何私钥、Secret、Token。完成后返回 JSON，包含 summary、changes、verification。",
              "workspace_path": "input.workspace_root",
              "result_schema": "schemas/development-result.schema.json",
              "timeout_seconds": 3600
            }
          },
          {
            "id": "DEV-REVIEW",
            "title": "DSH 自检与反馈",
            "kind": "runtime",
            "execution_mode": "sync",
            "risk_level": "read_only",
            "depends_on": [
              "DEV-CODE"
            ],
            "runtime": {
              "provider": "himind.builtin",
              "prompt": "独立审查需求、验收标准、约束、代码变更、测试和构建结果。若仍有明确缺口，返回 rejected；若已经满足条件，返回 accepted。必须返回 JSON：{\"feedback\":{\"decision\":\"accepted|rejected\",\"reason\":\"...\"}}。",
              "workspace_path": "input.workspace_root",
              "result_schema": "schemas/development-feedback.schema.json",
              "timeout_seconds": 900
            }
          }
        ]
      }
    },
    {
      "id": "WX-BUILD",
      "title": "按展馆和环境构建",
      "kind": "capability",
      "capability_id": "wechat.miniprogram.build",
      "execution_mode": "long_running",
      "risk_level": "process",
      "depends_on": [
        "DEV-LOOP"
      ]
    },
    {
      "id": "WX-CANDIDATE",
      "title": "冻结上传候选",
      "kind": "capability",
      "capability_id": "workflow.candidate.freeze",
      "candidate_action": "freeze",
      "execution_mode": "sync",
      "risk_level": "local_write",
      "depends_on": [
        "WX-BUILD"
      ]
    },
    {
      "id": "WX-READINESS",
      "title": "校验目标产物和上传环境",
      "kind": "capability",
      "capability_id": "wechat.miniprogram.ci.readiness",
      "candidate_action": "require",
      "execution_mode": "sync",
      "risk_level": "read_only",
      "depends_on": [
        "WX-CANDIDATE"
      ]
    },
    {
      "id": "WX-UPLOAD",
      "title": "上传微信体验版",
      "kind": "capability",
      "capability_id": "wechat.miniprogram.upload",
      "candidate_action": "require",
      "execution_mode": "long_running",
      "risk_level": "R3",
      "approval_required": true,
      "depends_on": [
        "WX-READINESS"
      ]
    }
  ],
  "artifacts": [
    {
      "id": "candidate",
      "artifact_type": "candidate",
      "name": "不可变上传候选",
      "schema": "artifacts/candidate.schema.json",
      "required": true,
      "validation": "strict",
      "max_bytes": 1048576
    },
    {
      "id": "experience-version",
      "artifact_type": "wechat_experience_version",
      "name": "微信体验版记录",
      "schema": "artifacts/experience-version.schema.json",
      "required": true,
      "validation": "strict",
      "max_bytes": 4194304
    }
  ],
  "ui": {
    "mode": "declarative",
    "surfaces": [
      "agent",
      "dashboard"
    ],
    "entry": "ui/workflow-view.json"
  },
  "supported_runtimes": [
    "himind.builtin"
  ],
  "created_at": "2026-09-17T00:00:00Z"
}
