{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://himind.local/schemas/video-to-motion/platform-profile.schema.json",
  "title": "IOUI Motion Platform Capability Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "platform_profile_id",
    "display_name",
    "plugin",
    "capability_class",
    "protocol_variant",
    "active_command",
    "motion_axes",
    "controls",
    "effects",
    "semantics",
    "safety",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "platform_profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "plugin": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "capability_class": {
      "enum": [
        "heave_only",
        "pitch_roll_heave",
        "pitch_roll",
        "pitch_roll_legacy",
        "full_6dof"
      ]
    },
    "protocol_variant": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "active_command": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "motion_axes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/axis"
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/control"
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/effect"
      }
    },
    "protocol_constraints": {
      "type": "object",
      "additionalProperties": true
    },
    "semantics": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/semantic"
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "safe_stop_mode",
        "feedback",
        "tail_reset_required"
      ],
      "properties": {
        "safe_stop_mode": {
          "enum": [
            "estimated",
            "confirmed",
            "reset_only",
            "none"
          ]
        },
        "feedback": {
          "enum": [
            "none",
            "estimated",
            "confirmed"
          ]
        },
        "tail_reset_required": {
          "const": true
        },
        "tail_reset_margin_ms": {
          "type": "integer",
          "minimum": 0
        },
        "reset_roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "path",
          "observed"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "observed": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "channel",
        "value_type",
        "unit",
        "min",
        "max",
        "neutral",
        "direction",
        "direction_status"
      ],
      "properties": {
        "role": {
          "enum": [
            "pitch",
            "roll",
            "yaw",
            "surge",
            "sway",
            "heave",
            "angle"
          ]
        },
        "channel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "value_type": {
          "enum": [
            "float"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "neutral": {
          "type": "number"
        },
        "max_slew_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "slew_rate_status": {
          "enum": [
            "configured",
            "field_candidate",
            "not_declared"
          ]
        },
        "direction": {
          "enum": [
            "positive_up",
            "positive_down",
            "positive_forward",
            "positive_left",
            "positive_right",
            "positive_clockwise",
            "unknown"
          ]
        },
        "direction_status": {
          "enum": [
            "confirmed",
            "provisional"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "kind"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "kind": {
          "enum": [
            "speed",
            "timing",
            "reset",
            "enable",
            "command"
          ]
        },
        "channel": {
          "type": [
            "string",
            "null"
          ]
        },
        "min": {
          "type": [
            "number",
            "null"
          ]
        },
        "max": {
          "type": [
            "number",
            "null"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "channel",
        "mode"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "channel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "mode": {
          "enum": [
            "bool",
            "continuous_percent",
            "command"
          ]
        },
        "min": {
          "type": [
            "number",
            "null"
          ]
        },
        "max": {
          "type": [
            "number",
            "null"
          ]
        },
        "neutral": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "semantic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "output_roles",
        "requires_approval"
      ],
      "properties": {
        "status": {
          "enum": [
            "exact",
            "approximate",
            "unsupported"
          ]
        },
        "output_roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requires_approval": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "fallback_roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
