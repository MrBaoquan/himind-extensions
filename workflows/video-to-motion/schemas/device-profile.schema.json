{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://himind.local/schemas/device-profile.schema.json",
  "title": "Device Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "device", "axes"],
  "properties": {
    "schema_version": {"const": 1},
    "device": {"type": "string"},
    "axes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["role", "channel", "value_type"],
        "properties": {
          "role": {"type": "string"},
          "channel": {"type": "string"},
          "value_type": {"enum": ["float", "bool"]},
          "min": {"type": "number"},
          "max": {"type": "number"},
          "neutral": {"type": "number"},
          "unit": {"type": "string"},
          "max_slew_rate": {"type": "number"},
          "category": {"type": "string"}
        }
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
