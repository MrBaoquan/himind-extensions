{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://himind.local/schemas/video-to-motion/media-evidence.schema.json",
  "title": "Media Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "probe",
    "projection",
    "assets",
    "signals",
    "candidates"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "duration_ms",
        "fps",
        "width",
        "height"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "duration_ms": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "proxy_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "flat",
            "equirectangular"
          ]
        },
        "yaw_deg": {
          "type": "number"
        },
        "pitch_deg": {
          "type": "number"
        },
        "h_fov_deg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "v_fov_deg": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "contact_sheet": {
          "type": [
            "string",
            "null"
          ]
        },
        "keyframes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "signals": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "scene": {
          "type": "object"
        },
        "loudness": {
          "type": "object"
        },
        "transcript": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "time_ms",
          "kind",
          "evidence",
          "confidence"
        ],
        "properties": {
          "time_ms": {
            "type": "number",
            "minimum": 0
          },
          "kind": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
