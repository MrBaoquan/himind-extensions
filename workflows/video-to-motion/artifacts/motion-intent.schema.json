{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://himind.local/schemas/motion-intent.schema.json",
  "title": "Motion Intent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "device",
    "capability_constraints",
    "phrases"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "device": {
      "type": "string"
    },
    "viewpoint": {
      "type": "string"
    },
    "design_basis": {
      "type": "string"
    },
    "capability_constraints": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "motion_axes"
      ],
      "properties": {
        "motion_axes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "environment_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "normalized_peak": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "intensity_profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "heave_scale": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "wind_scale": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "purpose": {
            "type": "string"
          },
          "event_window_scale": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "drop_time_scale": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "phrases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "start_ms",
          "end_ms",
          "intent",
          "energy",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "start_ms": {
            "type": "number",
            "minimum": 0
          },
          "end_ms": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "intent": {
            "type": "string"
          },
          "energy": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "heave": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "base",
              "peak"
            ],
            "properties": {
              "base": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "peak": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "period_ms": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "shape": {
                "type": "string"
              }
            }
          },
          "gates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scent_windows": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "name": {
            "type": "string"
          },
          "behavior": {
            "type": "string"
          },
          "base": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "peak": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "shape": {
            "type": "string"
          },
          "environment": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "beats": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "type",
                "trough_time_ms",
                "energy"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "glide_pulse",
                    "deep_pulse",
                    "short_bump",
                    "lift_drop"
                  ]
                },
                "trough_time_ms": {
                  "type": "number",
                  "minimum": 0
                },
                "energy": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "note": {
                  "type": "string"
                }
              }
            }
          },
          "bed_ratio": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "anyOf": [
          {
            "required": [
              "heave"
            ]
          },
          {
            "required": [
              "base",
              "peak",
              "beats"
            ]
          }
        ]
      }
    },
    "review_gate": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string"
        },
        "must_confirm": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "duration_ms": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "revision": {
      "type": "string"
    },
    "environment_windows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "start_ms",
          "end_ms",
          "level"
        ],
        "properties": {
          "role": {
            "type": "string"
          },
          "start_ms": {
            "type": "number",
            "minimum": 0
          },
          "end_ms": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "level": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "fade_ms": {
            "type": "integer",
            "minimum": 0
          },
          "semantic": {
            "type": "string"
          }
        }
      }
    },
    "ending_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shutdown_start_ms",
        "neutral_reached_by_ms",
        "effects_off_by_ms",
        "heave_neutral",
        "require_all_effects_off"
      ],
      "properties": {
        "shutdown_start_ms": {
          "type": "number",
          "minimum": 0
        },
        "neutral_reached_by_ms": {
          "type": "number",
          "minimum": 0
        },
        "effects_off_by_ms": {
          "type": "number",
          "minimum": 0
        },
        "heave_neutral": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "require_all_effects_off": {
          "type": "boolean"
        },
        "neutral_hold_ms": {
          "type": "number",
          "minimum": 0
        },
        "note": {
          "type": "string"
        }
      }
    },
    "motion_bed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "max_static_gap_ms"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "max_static_gap_ms": {
          "type": "integer",
          "minimum": 0
        },
        "min_gap_ms": {
          "type": "integer",
          "minimum": 0
        },
        "sample_interval_ms": {
          "type": "integer",
          "minimum": 1
        },
        "min_amplitude": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "idle_fallback": {
          "type": "object",
          "additionalProperties": true
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
