{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://himind.local/schemas/behavior-timeline.schema.json",
  "title": "Behavior Timeline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "segments", "review"],
  "properties": {
    "schema_version": {"const": 1},
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": ["path", "duration_ms"],
      "properties": {
        "path": {"type": "string"},
        "duration_ms": {"type": "number", "exclusiveMinimum": 0},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "fps": {"type": "number", "exclusiveMinimum": 0},
        "viewpoint": {"type": "string"},
        "projection": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "type": {"enum": ["flat", "panoramic_equirectangular", "dome", "cylindrical", "unknown"]},
            "analysis_view": {"type": "string"},
            "yaw_deg": {"type": "number"},
            "pitch_deg": {"type": "number"},
            "h_fov_deg": {"type": "number"},
            "v_fov_deg": {"type": "number"},
            "policy": {"type": "string"}
          }
        }
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "start_ms", "end_ms", "behavior", "scene", "energy", "confidence", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "start_ms": {"type": "number", "minimum": 0},
          "end_ms": {"type": "number", "exclusiveMinimum": 0},
          "behavior": {"type": "string"},
          "scene": {"type": "string"},
          "energy": {"type": "number", "minimum": 0, "maximum": 1},
          "motion_class": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "visual_times_ms": {"type": "array", "items": {"type": "number"}},
              "signal_notes": {"type": "string"},
              "transcript": {"type": "string"}
            }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["time_ms", "type", "confidence"],
        "properties": {
          "time_ms": {"type": "number", "minimum": 0},
          "type": {"type": "string"},
          "intensity": {"type": "number", "minimum": 0, "maximum": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "source": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status"],
      "properties": {
        "status": {"type": "string"},
        "high_risk_segments": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
