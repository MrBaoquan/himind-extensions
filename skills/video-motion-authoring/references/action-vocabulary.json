{
  "schema_version": 1,
  "summary": "把「视频里发生了什么」翻译成「平台该做哪个动作」的判据表。",
  "form_explained": {
    "pose": "有姿态角色的动作。写成 spec 的 presets + cues（一个动作可被多个节拍按不同强度复用）。",
    "gate": "纯环境动作，没有姿态角色。**只写成 spec 的 gates**（开关窗口），不要写成 preset —— 没有 channels 的预设会被预检判为 preset.no_channels。"
  },
  "how_to_use": [
    "先调用 iostudio.devices 取目标设备的真实动作与通道，再用本表选动作。",
    "本表只给**语义角色**（role），不给具体通道。通道名必须来自 devices 的实际声明 —— 猜通道名会导致输出被静默丢弃。",
    "先按 signal 找到候选段落，再看拼图确认画面里到底发生了什么，两者一致才采用。",
    "任何一段都要能说出它是被哪条 signal 与哪几格画面支持的；说不出就别配。"
  ],
  "signal_reading": {
    "why_relative": "画面变化分数（scene.score）的**绝对值没有普适阈值**。实测一条真实影片（大量叠化转场）逐帧最高分只有 9.0，按常规阈值 10 会得到 0 个切点 —— 阈值式硬切检测对真实内容并不可靠。因此一律用**相对该片自身**的分布来判断，不要用固定数字。",
    "scene": {
      "source": "media.toolkit.scene.score",
      "low": "持续低于该片中位数 → 静态/对话/静场",
      "mid": "在中位数附近起伏 → 稳定运动（行进、巡航、稳定跟拍）",
      "high": "出现远高于中位数的尖峰 → 冲击、爆点、快速切换、剧烈运动",
      "sustained_high": "连续多秒高位 → 持续激烈段落（追逐、战斗、高速运动）"
    },
    "loudness": {
      "source": "media.toolkit.audio.loudness",
      "spike": "瞬时响度骤升 → 撞击、爆炸、重音、音效重拍（是判断「事件时刻」最可靠的信号）",
      "quiet": "显著低于该片中位数 → 静场、留白、悬念（适合弱动作或完全静止）",
      "sustained": "长时间稳定响亮 → 音乐段/连续动作段"
    },
    "contact_sheet": {
      "source": "media.toolkit.frames.contact-sheet",
      "purpose": "画面里到底在发生什么。signal 只能告诉你「哪里激烈」，不能告诉你「是什么在激烈」—— 必须看图确认是撞击、起飞还是爆炸。",
      "tip": "看不出内容时，用 frames.extract 在候选时刻附近抽帧放大看。"
    },
    "transcript": {
      "source": "media.ai.transcribe",
      "why": "画面与响度只能告诉你「哪里激烈」，歌词与对白能告诉你「在讲什么」。实测一段音乐片用前两条信号都找不到段落结构（曲线平在中位、峰值仅 9.0），歌词却给出稳定的 4-5 秒一句的节律 —— 编排时最缺的时点依据。",
      "use": "用 content_segments 的句边界作为段落与节拍边界；先通读 full_text 判断情绪走向，它常能纠正仅凭信号得出的误判（如把安静的对白当成静场）。",
      "gotcha": "必须显式指定 language（zh/en/ja…）。自动检测对歌曲不可靠 —— 实测把中文歌判成 en，只得到占位标注。看 content_segments 而不是 segments。"
    }
  },
  "neutral_conventions": {
    "attitude": "姿态类（pitch/roll/yaw/heave/surge/sway/angle）关键帧以 0.5 为中性位；数值含义见各动作。",
    "notice": "实际中性值由设备/轨道决定（spec 的 neutral 字段）。若目标设备的 heave 中性为 0（下限位），需把 0.5 附近的值平移到该设备的工作区间，不能照抄。",
    "gate": "环境类（wind/water/hot/vibrate/light/scent…）是开关量，用 gates 表达开窗，不要用曲线。"
  },
  "roles": {
    "pitch": "前后俯仰",
    "roll": "左右侧倾",
    "yaw": "左右回转",
    "heave": "上下升降（主力动作通道，绝大多数情绪的落点）",
    "surge": "前后平移",
    "sway": "左右横移",
    "angle": "转台旋转",
    "vibrate": "震动",
    "wind": "风扇/吹风",
    "water": "喷水",
    "fog": "烟雾",
    "snow": "雪",
    "hot": "热风",
    "light": "灯光",
    "lightning": "闪电",
    "scent": "气味",
    "shoot": "射击（游戏动作）",
    "action": "动作（游戏动作）",
    "motion_enable": "运动使能（安全联锁，见 safety）",
    "reset": "复位",
    "emergency_stop": "急停"
  },
