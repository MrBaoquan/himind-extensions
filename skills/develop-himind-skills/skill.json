{
  "id": "com.himind.skill.develop-himind-skills",
  "name": "技能开发助手",
  "author": "马宝全",
  "categories": ["software-engineering"],
  "version": "1.3.1",
  "scope": "organization",
  "description": "使用中文规范创建、校验、跨客户端测试、打包并受控提交 HiMind 技能。",
  "release_notes": "更新 Git 协作规则，明确作者与贡献者均可构建并提交审核。",
  "min_agent_version": "0.3.1",
  "supported_clients": [
    "codex",
    "github-copilot",
    "workbuddy"
  ],
  "capabilities": [
    {"id": "extension.authoring.identity", "required": true, "min_version": "1.0.0", "provider": "agent"},
    {"id": "extension.environment.preflight", "required": true, "min_version": "1.1.0", "provider": "com.himind.extension-development-tools"},
    {"id": "extension.skill.scaffold", "required": true, "min_version": "1.1.0", "provider": "com.himind.extension-development-tools"},
    {"id": "extension.skill.validate", "required": true, "min_version": "1.1.0", "provider": "com.himind.extension-development-tools"},
    {"id": "extension.skill.package", "required": true, "min_version": "1.1.0", "provider": "com.himind.extension-development-tools"},
    {"id": "extension.skill.candidate.save", "required": true, "min_version": "1.0.0", "provider": "agent"},
    {"id": "extension.skill.candidate.test", "required": true, "min_version": "1.0.0", "provider": "agent"},
    {"id": "extension.skill.submission.submit", "required": true, "min_version": "1.0.0", "provider": "agent"},
    {"id": "extension.skill.submission.status", "required": true, "min_version": "1.0.0", "provider": "agent"}
  ],
  "plugin_dependencies": [
    {
      "plugin_id": "com.himind.extension-development-tools",
      "required": true,
      "min_version": "1.1.1"
    }
  ],
  "risk_summary": "local_write; submission_requires_confirmation; publication_requires_admin_review",
  "contents": [
    "skill.json",
    "SKILL.md",
    "agents/openai.yaml"
  ]
}
