{
  "id": "com.himind.skill.work-log",
  "icon": "assets/icon.png",
  "name": "工作日志助手",
  "author": "马宝全",
  "categories": ["collaboration-delivery", "docs-knowledge"],
  "version": "0.6.2",
  "distribution_targets": ["workbench", "github"],
  "scope": "organization",
  "description": "把 AI 会话整理成结构化工作日志，并维护当前工作台、工作项与每日计划：项目状态、优先级、下一步、预计耗时与时间块。",
  "release_notes": "0.6.2：季度与年度总结支持按公司财年起算月划分，报告键随口径变化。",
  "min_agent_version": "0.3.0",
  "supported_clients": ["himind-ai", "codex", "github-copilot", "workbuddy"],
  "capabilities": [
    {"id": "work-log.entry.upsert", "required": true, "min_version": "0.1.0", "provider": "com.himind.work-log"},
    {"id": "work-log.entry.delete", "required": false, "min_version": "0.4.0", "provider": "com.himind.work-log"},
    {"id": "work-log.entry.list", "required": false, "min_version": "0.1.0", "provider": "com.himind.work-log"},
    {"id": "work-log.archive.calendar", "required": false, "min_version": "0.1.0", "provider": "com.himind.work-log"},
    {"id": "work-log.report.render", "required": false, "min_version": "0.1.0", "provider": "com.himind.work-log"},
    {"id": "work-log.project.list", "required": false, "min_version": "0.2.0", "provider": "com.himind.work-log"},
    {"id": "work-log.project.upsert", "required": false, "min_version": "0.2.0", "provider": "com.himind.work-log"},
    {"id": "work-log.project.resolve", "required": false, "min_version": "0.2.0", "provider": "com.himind.work-log"},
    {"id": "work-log.source.list", "required": false, "min_version": "0.2.0", "provider": "com.himind.work-log"},
    {"id": "work-log.entry.read", "required": false, "min_version": "0.1.0", "provider": "com.himind.work-log"},
    {"id": "work-log.project.assign", "required": false, "min_version": "0.1.0", "provider": "com.himind.work-log"},
    {"id": "work-log.source.save", "required": false, "min_version": "0.1.0", "provider": "com.himind.work-log"},
    {"id": "work-log.project.board", "required": false, "min_version": "0.15.0", "provider": "com.himind.work-log"},
    {"id": "work-log.project.work.update", "required": false, "min_version": "0.15.0", "provider": "com.himind.work-log"},
    {"id": "work-log.item.list", "required": false, "min_version": "0.15.0", "provider": "com.himind.work-log"},
    {"id": "work-log.item.upsert", "required": false, "min_version": "0.15.0", "provider": "com.himind.work-log"},
    {"id": "work-log.item.update", "required": false, "min_version": "0.15.0", "provider": "com.himind.work-log"},
    {"id": "work-log.plan.get", "required": false, "min_version": "0.15.0", "provider": "com.himind.work-log"},
    {"id": "work-log.plan.save", "required": false, "min_version": "0.15.0", "provider": "com.himind.work-log"},
    {"id": "work-log.plan.validate", "required": false, "min_version": "0.15.0", "provider": "com.himind.work-log"},
    {"id": "work-log.plan.auto", "required": false, "min_version": "0.15.0", "provider": "com.himind.work-log"},
    {"id": "work-log.plan.review", "required": false, "min_version": "0.15.0", "provider": "com.himind.work-log"},
    {"id": "work-log.preferences.get", "required": false, "min_version": "0.16.0", "provider": "com.himind.work-log"},
    {"id": "work-log.preferences.save", "required": false, "min_version": "0.16.0", "provider": "com.himind.work-log"}
  ],
  "plugin_dependencies": [
    {"plugin_id": "com.himind.work-log", "required": true, "min_version": "0.16.0"}
  ],
  "risk_summary": "read_only_by_default; writing_logs_requires_user_confirmation",
  "contents": [
    "skill.json",
    "SKILL.md",
    "agents/openai.yaml",
    "assets/icon.png"
  ]
}
