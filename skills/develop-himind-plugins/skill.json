{
  "id": "com.himind.skill.develop-himind-plugins",
  "icon": "assets/icon.png",
  "name": "插件开发助手",
  "author": "马宝全",
  "categories": [
    "software-engineering"
  ],
  "version": "1.7.5",
  "distribution_targets": [
    "workbench",
    "github"
  ],
  "scope": "organization",
  "description": "使用中文规范设计、构建、校验、调试并打包 HiMind Agent 插件。",
  "release_notes": "1.7.5：修复与内置扩展工具链对齐后未提升版本导致的重新安装冲突。",
  "min_agent_version": "0.3.37",
  "supported_clients": [
    "himind-ai",
    "codex",
    "github-copilot",
    "workbuddy"
  ],
  "capabilities": [
    {
      "id": "extension.authoring.identity",
      "required": true,
      "min_version": "1.0.0",
      "provider": "agent"
    },
    {
      "id": "extension.authoring.preflight",
      "required": true,
      "min_version": "1.0.0",
      "provider": "agent"
    },
    {
      "id": "extension.workspace.current",
      "required": true,
      "min_version": "1.0.0",
      "provider": "agent"
    },
    {
      "id": "extension.workspace.bind",
      "required": true,
      "min_version": "1.0.0",
      "provider": "agent"
    },
    {
      "id": "extension.workspace.clear",
      "required": false,
      "min_version": "1.0.0",
      "provider": "agent"
    },
    {
      "id": "extension.revision.create",
      "required": true,
      "min_version": "1.0.0",
      "provider": "agent"
    },
    {
      "id": "extension.environment.preflight",
      "required": true,
      "min_version": "1.3.2",
      "provider": "com.himind.extension-development-tools"
    },
    {
      "id": "extension.plugin.scaffold",
      "required": true,
      "min_version": "1.3.2",
      "provider": "com.himind.extension-development-tools"
    },
    {
      "id": "extension.plugin.validate",
      "required": true,
      "min_version": "1.3.2",
      "provider": "com.himind.extension-development-tools"
    },
    {
      "id": "extension.plugin.build",
      "required": true,
      "min_version": "1.3.2",
      "provider": "com.himind.extension-development-tools"
    },
    {
      "id": "extension.plugin.package",
      "required": true,
      "min_version": "1.3.2",
      "provider": "com.himind.extension-development-tools"
    },
    {
      "id": "extension.plugin.candidate.save",
      "required": true,
      "min_version": "1.0.0",
      "provider": "agent"
    },
    {
      "id": "extension.test",
      "required": true,
      "min_version": "1.0.0",
      "provider": "agent"
    },
    {
      "id": "extension.plugin.submission.submit",
      "required": false,
      "min_version": "1.0.0",
      "provider": "agent"
    },
    {
      "id": "extension.plugin.submission.status",
      "required": false,
      "min_version": "1.0.0",
      "provider": "agent"
    }
  ],
  "plugin_dependencies": [],
  "risk_summary": "local_write_and_process; submission_requires_confirmation; publication_requires_admin_review",
  "contents": [
    "skill.json",
    "SKILL.md",
    "agents/openai.yaml",
    "assets/icon.png"
  ]
}
