{
  "id": "com.himind.skill.develop-himind-plugins",
  "name": "插件开发助手",
  "author": "马宝全",
  "categories": ["software-engineering"],
  "version": "1.7.0",
  "scope": "organization",
  "description": "使用中文规范设计、构建、校验、调试并打包 HiMind Agent 插件。",
  "release_notes": "增加 Agent 统一预检、扩展修订入口和结构化 blockers，支持外部 AI 完成插件及三件套自身迭代闭环。",
  "min_agent_version": "0.3.37",
  "supported_clients": [
    "himind-ai",
    "codex",
    "github-copilot",
    "workbuddy"
  ],
  "capabilities": [
    {"id": "extension.authoring.identity", "required": true, "min_version": "1.0.0", "provider": "agent"},
    {"id": "extension.authoring.preflight", "required": true, "min_version": "1.0.0", "provider": "agent"},
    {"id": "extension.workspace.current", "required": true, "min_version": "1.0.0", "provider": "agent"},
    {"id": "extension.workspace.bind", "required": true, "min_version": "1.0.0", "provider": "agent"},
    {"id": "extension.workspace.clear", "required": false, "min_version": "1.0.0", "provider": "agent"},
    {"id": "extension.revision.create", "required": true, "min_version": "1.0.0", "provider": "agent"},
    {"id": "extension.environment.preflight", "required": true, "min_version": "1.3.1", "provider": "com.himind.extension-development-tools"},
    {"id": "extension.plugin.scaffold", "required": true, "min_version": "1.3.1", "provider": "com.himind.extension-development-tools"},
    {"id": "extension.plugin.validate", "required": true, "min_version": "1.3.1", "provider": "com.himind.extension-development-tools"},
    {"id": "extension.plugin.build", "required": true, "min_version": "1.3.1", "provider": "com.himind.extension-development-tools"},
    {"id": "extension.plugin.package", "required": true, "min_version": "1.3.1", "provider": "com.himind.extension-development-tools"},
    {"id": "extension.plugin.candidate.save", "required": true, "min_version": "1.0.0", "provider": "agent"},
    {"id": "extension.test", "required": true, "min_version": "1.0.0", "provider": "agent"},
    {"id": "extension.plugin.submission.submit", "required": false, "min_version": "1.0.0", "provider": "agent"},
    {"id": "extension.plugin.submission.status", "required": false, "min_version": "1.0.0", "provider": "agent"}
  ],
  "plugin_dependencies": [
    {
      "plugin_id": "com.himind.extension-development-tools",
      "required": true,
      "min_version": "1.3.1"
    }
  ],
  "risk_summary": "local_write_and_process; submission_requires_confirmation; publication_requires_admin_review",
  "contents": [
    "skill.json",
    "SKILL.md",
    "agents/openai.yaml"
  ]
}
