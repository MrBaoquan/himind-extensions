{
  "id": "com.himind.skill.software-distribution",
  "name": "软件分发对接",
  "author": "马宝全",
  "categories": ["software-engineering", "collaboration-delivery", "testing-quality"],
  "version": "1.3.2",
  "scope": "organization",
  "description": "为 WPF、Unity Windows 或 Unity Android 项目完成软件分发接入检查、制品校验，并在连接组织分发服务后验证更新链路。",
  "release_notes": "统一显式本机项目目录与发布授权流程，并依赖修复 Windows 路径判定的软件分发插件 1.2.1。",
  "min_agent_version": "0.3.37",
  "supported_clients": ["himind-ai", "codex", "github-copilot", "workbuddy"],
  "capabilities": [
    {"id":"software.distribution.project.inspect","required":true,"min_version":"1.2.1","provider":"com.himind.software-distribution"},
    {"id":"software.distribution.artifact.inspect","required":true,"min_version":"1.2.1","provider":"com.himind.software-distribution"},
    {"id":"software.distribution.release.publish","required":false,"min_version":"1.1.0","provider":"builtin"},
    {"id":"software.distribution.release.resolve","required":false,"min_version":"1.2.1","provider":"com.himind.software-distribution"}
  ],
  "plugin_dependencies": [
    {"plugin_id":"com.himind.software-distribution","required":true,"min_version":"1.2.1"}
  ],
  "risk_summary": "read_only_by_default; publish_requires_user_confirmation_and_agent_oauth_scope",
  "contents": ["skill.json", "SKILL.md", "agents/openai.yaml"]
}
