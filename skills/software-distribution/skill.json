{
  "id": "com.himind.skill.software-distribution",
  "name": "软件分发对接",
  "author": "马宝全",
  "categories": ["software-engineering", "collaboration-delivery", "testing-quality"],
  "version": "1.2.0",
  "scope": "organization",
  "description": "为 WPF、Unity Windows 或 Unity Android 项目完成软件分发接入检查、制品校验，并在连接组织分发服务后验证更新链路。",
  "release_notes": "明确领域插件与 Agent 信任内核边界，发布必须绑定当前 AI 工作区、短时预检收据及不可变制品摘要。",
  "min_agent_version": "0.3.33",
  "supported_clients": ["himind-ai", "codex", "github-copilot", "workbuddy"],
  "capabilities": [
    {"id":"workspace.current","required":true,"min_version":"1.0.0","provider":"builtin"},
    {"id":"software.distribution.project.inspect","required":true,"min_version":"1.1.0","provider":"com.himind.software-distribution"},
    {"id":"software.distribution.artifact.inspect","required":true,"min_version":"1.1.0","provider":"com.himind.software-distribution"},
    {"id":"software.distribution.release.publish","required":false,"min_version":"1.1.0","provider":"builtin"},
    {"id":"software.distribution.release.resolve","required":false,"min_version":"1.1.0","provider":"com.himind.software-distribution"}
  ],
  "plugin_dependencies": [
    {"plugin_id":"com.himind.software-distribution","required":true,"min_version":"1.1.0"}
  ],
  "risk_summary": "read_only_by_default; publish_requires_user_confirmation_and_agent_oauth_scope",
  "contents": ["skill.json", "SKILL.md", "agents/openai.yaml"]
}
