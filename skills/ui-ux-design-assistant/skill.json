{
  "id": "com.himind.skill.ui-ux-design-assistant",
  "name": "界面设计助手",
  "author": "马宝全",
  "categories": ["visual-design", "software-engineering"],
  "version": "0.2.0",
  "scope": "organization",
  "distribution_targets": ["workbench"],
  "description": "根据产品、平台与用户目标生成设计系统方向，读取项目设计约束、受控维护设计系统文件、校验令牌并指导界面落地；当用户新建或改版界面、选择风格配色字体、生成设计系统或统一组件规则时使用。",
  "release_notes": "0.2.0：新增项目上下文检查、设计系统受控持久化、令牌校验、CJK 字体搭配与软件界面规范交接。",
  "min_agent_version": "0.3.47",
  "supported_clients": ["agent-skills"],
  "capabilities": [
    {"id": "ui-ux.project.inspect", "required": true, "min_version": "0.2.0", "provider": "com.himind.ui-ux-design-tools"},
    {"id": "ui-ux.design-system.generate", "required": true, "min_version": "0.2.0", "provider": "com.himind.ui-ux-design-tools"},
    {"id": "ui-ux.design-system.persist", "required": true, "min_version": "0.2.0", "provider": "com.himind.ui-ux-design-tools"},
    {"id": "ui-ux.token.validate", "required": true, "min_version": "0.2.0", "provider": "com.himind.ui-ux-design-tools"},
    {"id": "ui-ux.guideline.search", "required": true, "min_version": "0.2.0", "provider": "com.himind.ui-ux-design-tools"},
    {"id": "ui-ux.catalog.describe", "required": false, "min_version": "0.2.0", "provider": "com.himind.ui-ux-design-tools"}
  ],
  "plugin_dependencies": [
    {"plugin_id": "com.himind.ui-ux-design-tools", "required": true, "min_version": "0.2.0"}
  ],
  "risk_summary": "只读项目检查与设计建议；设计系统写入仅限工作区约定路径，覆盖已有文件需用户确认；不联网、不执行脚本。",
  "contents": ["skill.json", "SKILL.md", "agents/openai.yaml"]
}