{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "3D data story renderer input",
  "type": "object",
  "required": ["title", "subtitle", "unit", "source", "items", "duration"],
  "additionalProperties": false,
  "properties": {
    "title": {"type": "string"},
    "subtitle": {"type": "string"},
    "unit": {"type": "string"},
    "source": {"type": "string"},
    "duration": {"type": "integer", "minimum": 4, "maximum": 30},
    "items": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["name", "value", "order"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string"},
          "value": {"type": "number", "minimum": 0},
          "order": {"type": "integer", "minimum": 1, "maximum": 6}
        }
      }
    }
  }
}