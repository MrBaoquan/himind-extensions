{
  "id": "com.himind.wechat-miniprogram-tools",
  "name": "微信小程序开发工具",
  "author": "马宝全",
  "categories": [
    "software-engineering",
    "testing-quality",
    "collaboration-delivery"
  ],
  "description": "提供微信小程序/小游戏的 CI 交付、开发者工具控制、自动化、调试与云开发能力。",
  "release_notes": "0.4.0：合并交付与开发者工具控制能力，保留现有 CI 能力，新增 devtools、cloud 与安装检测能力。",
  "version": "0.4.0",
  "capability_namespace": "wechat.miniprogram",
  "distribution_targets": [
    "workbench",
    "github"
  ],
  "entry": "wechat-miniprogram-tools.exe",
  "runtime": "process-jsonrpc-stdio",
  "platforms": [
    "windows-x64"
  ],
  "min_agent_version": "0.3.47",
  "governance": "managed",
  "capabilities": [
    {
      "id": "wechat.miniprogram.requirements.snapshot",
      "description": "把真实需求、验收标准和约束固化成本地需求快照",
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace_root": {
            "type": "string"
          },
          "source_root": {
            "type": "string"
          },
          "project_root": {
            "type": "string"
          },
          "artifact_dir": {
            "type": "string"
          },
          "requirement": {
            "type": "string"
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "candidate": {
            "type": "object"
          },
          "workflow_context": {
            "type": "object"
          }
        },
        "required": [
          "workspace_root",
          "requirement"
        ],
        "additionalProperties": false
      },
      "risk_level": "local_write",
      "availability": "local"
    },
    {
      "id": "wechat.miniprogram.project.inspect",
      "description": "检查真实小程序工程、AppID、目录结构和工具配置",
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace_root": {
            "type": "string"
          },
          "source_root": {
            "type": "string"
          },
          "project_root": {
            "type": "string"
          },
          "candidate": {
            "type": "object"
          },
          "workflow_context": {
            "type": "object"
          }
        },
        "required": [
          "workspace_root",
          "project_root"
        ],
        "additionalProperties": false
      },
      "risk_level": "read_only",
      "availability": "local"
    },
