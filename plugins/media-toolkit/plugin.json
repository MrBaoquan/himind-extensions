{
  "id": "com.himind.media-toolkit",
  "icon": "assets/icon.png",
  "name": "媒体处理工具",
  "author": "马宝全",
  "categories": [
    "video-post",
    "audio-sound"
  ],
  "description": "对图片、视频与音频做确定性处理与测量：图片批量转换、视频转换、图片转视频、媒体参数分析、抽帧拼图与响度曲线。",
  "release_notes": "2.3.2：素材区合并为单一拖拽/点击目标；移除独立选择按钮与手动路径；修复原生文件选择器兼容性和拖拽窗口事件绑定。",
  "version": "2.3.2",
  "entry": "bin/media-toolkit.exe",
  "runtime": "process-jsonrpc-stdio",
  "platforms": [
    "windows-x64"
  ],
  "min_agent_version": "0.3.47",
  "governance": "optional",
  "distribution_targets": [
    "workbench",
    "github"
  ],
  "capabilities": [
    {
      "id": "media.toolkit.runtime.status",
      "description": "查看 ffmpeg 是否就绪、可用能力与内置预设",
      "availability": "local",
      "timeout_seconds": 15,
      "risk_level": "read_only",
      "input_schema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "id": "media.toolkit.image.convert",
      "description": "批量转换图片格式，并可缩放、控制质量和输出命名",
      "availability": "local",
      "timeout_seconds": 900,
      "risk_level": "local_write",
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace_root": {
            "type": "string",
            "maxLength": 1000
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "items": {
              "type": "string",
              "maxLength": 1000
            }
          },
          "output_dir": {
            "type": "string",
            "maxLength": 1000
          },
          "format": {
            "enum": [
              "jpeg",
              "jpg",
              "png",
              "webp",
              "bmp",
              "tiff",
              "tif",
              "gif"
            ]
          },
          "width": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16384
          },
          "height": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16384
          },
          "quality": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "background": {
            "type": "string",
            "maxLength": 7
          },
          "suffix": {
            "type": "string",
            "maxLength": 80
          },
          "name_template": {
            "type": "string",
            "maxLength": 160
          },
          "overwrite": {
            "type": "boolean"
          }
        },
        "required": [
          "workspace_root",
          "paths",
          "output_dir",
          "format"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "media.toolkit.images.to-video",
      "description": "把单张图片或编号图片序列合成为视频，可选加入音轨",
      "availability": "local",
      "timeout_seconds": 1800,
      "risk_level": "local_write",
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace_root": {
            "type": "string",
            "maxLength": 1000
          },
          "image_path": {
            "type": "string",
            "maxLength": 1000
          },
          "output": {
            "type": "string",
            "maxLength": 1000
          },
          "audio_path": {
            "type": "string",
            "maxLength": 1000
          },
          "fps": {
            "type": "number",
            "minimum": 1,
            "maximum": 120
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 100
          },
          "width": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7680
          },
          "height": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4320
          },
          "crf": {
            "type": "integer",
            "minimum": 0,
            "maximum": 51
          },
          "overwrite": {
            "type": "boolean"
          }
        },
        "required": [
          "workspace_root",
          "image_path",
          "output"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "media.toolkit.probe",
      "description": "读取媒体的时长、帧率、分辨率与轨道信息",
      "availability": "local",
      "timeout_seconds": 60,
      "risk_level": "read_only",
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace_root": {
            "type": "string",
            "maxLength": 1000
          },
          "path": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "workspace_root",
          "path"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "media.toolkit.video.convert",
      "description": "把视频转换为 MP4/MOV/MKV/WebM，并控制编码、尺寸、帧率与质量",
      "availability": "local",
      "timeout_seconds": 1800,
      "risk_level": "local_write",
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace_root": {
            "type": "string",
            "maxLength": 1000
          },
          "path": {
            "type": "string",
            "maxLength": 1000
          },
          "output": {
            "type": "string",
            "maxLength": 1000
          },
          "format": {
            "enum": [
              "mp4",
              "mov",
              "mkv",
              "webm"
            ]
          },
          "video_codec": {
            "enum": [
              "h264",
              "h265",
              "vp9",
              "copy"
            ]
          },
          "audio_codec": {
            "enum": [
              "aac",
              "opus",
              "mp3",
              "copy",
              "none"
            ]
          },
          "width": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7680
          },
          "height": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4320
          },
          "fps": {
            "type": "number",
            "minimum": 1,
            "maximum": 240
          },
          "crf": {
            "type": "integer",
            "minimum": 0,
            "maximum": 51
          },
          "video_bitrate_kbps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200000
          },
          "audio_bitrate_kbps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1024
          },
          "preset": {
            "enum": [
              "veryfast",
              "fast",
              "medium",
              "slow",
              "slower",
              "veryslow"
            ]
          },
          "overwrite": {
            "type": "boolean"
          }
        },
        "required": [
          "workspace_root",
          "path",
          "output",
          "format"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "media.toolkit.media.analyze",
      "description": "返回归一化的容器、视频、音频与文件参数及告警",
      "availability": "local",
      "timeout_seconds": 60,
      "risk_level": "read_only",
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace_root": {
            "type": "string",
            "maxLength": 1000
          },
          "path": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "workspace_root",
          "path"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "media.toolkit.video.project",
      "description": "把等距柱状全景视频展开成固定主前向视图",
      "availability": "local",
      "timeout_seconds": 1800,
      "risk_level": "local_write",
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace_root": {
            "type": "string",
            "maxLength": 1000
          },
          "path": {
            "type": "string",
            "maxLength": 1000
          },
          "output": {
            "type": "string",
            "maxLength": 1000
          },
          "yaw_deg": {
            "type": "number",
            "minimum": -360,
            "maximum": 360
          },
          "pitch_deg": {
            "type": "number",
            "minimum": -89,
            "maximum": 89
          },
          "h_fov_deg": {
            "type": "number",
            "minimum": 1,
            "maximum": 179
          },
          "v_fov_deg": {
            "type": "number",
            "minimum": 1,
            "maximum": 179
          },
          "width": {
            "type": "integer",
            "minimum": 320,
            "maximum": 7680
          },
          "height": {
            "type": "integer",
            "minimum": 240,
            "maximum": 4320
          },
          "crf": {
            "type": "integer",
            "minimum": 12,
            "maximum": 35
          }
        },
        "required": [
          "workspace_root",
          "path",
          "output"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "media.toolkit.recipe.plan",
      "description": "只把处理步骤编译成 ffmpeg 参数，不执行",
      "availability": "local",
      "timeout_seconds": 15,
      "risk_level": "read_only",
      "input_schema": {
        "type": "object",
        "properties": {
          "recipe": {
            "$comment": "声明式处理步骤，见插件 README 的 recipe 结构说明",
            "type": "object"
          }
        },
        "required": [
          "recipe"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "media.toolkit.recipe.run",
      "description": "执行媒体处理并返回可跟踪的作业",
      "availability": "local",
      "timeout_seconds": 60,
      "risk_level": "local_write",
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace_root": {
            "type": "string",
            "maxLength": 1000
          },
          "kind": {
            "type": "string",
            "maxLength": 40
          },
          "recipe": {
            "type": "object"
          }
        },
        "required": [
          "workspace_root",
          "recipe"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "media.toolkit.job.status",
      "description": "查询作业的进度、产物与错误",
      "availability": "local",
      "timeout_seconds": 15,
      "risk_level": "read_only",
      "input_schema": {
        "type": "object",
        "properties": {
          "job_id": {
            "type": "string",
            "maxLength": 64
          }
        },
        "required": [
          "job_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "media.toolkit.job.cancel",
      "description": "取消正在运行的作业",
      "availability": "local",
      "timeout_seconds": 15,
      "risk_level": "local_write",
      "input_schema": {
        "type": "object",
        "properties": {
