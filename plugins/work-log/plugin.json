{
  "id": "com.himind.work-log",
  "name": "工作日志工具",
  "author": "马宝全",
  "categories": ["collaboration-delivery", "docs-knowledge"],
  "description": "以按日工作日志为核心：条目按仓库路径/项目/展项稳定归类，含功能与工时；报告按 项目→功能→工时 聚合，含月报、项目进展与月度工时表；周报/月报按自然周期自动补算并去重。",
  "release_notes": "0.11.2：自动补路径更稳——跳过临时/缓存/草稿目录，链接工作树解析到主仓库，只补真实项目主路径，并回报被忽略项。",
  "version": "0.11.2",
  "distribution_targets": ["workbench", "github"],
  "entry": "bin/work-log.exe",
  "runtime": "process-jsonrpc-stdio",
  "platforms": ["windows-x64"],
  "min_agent_version": "0.3.0",
  "governance": "optional",
  "capabilities": [
    {
      "id": "work-log.entry.upsert",
      "description": "写入或合并某天的日志条目，按稳定 ID 幂等去重",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "date": {"type": "string"},
          "mode": {"type": "string", "enum": ["merge", "replace"]},
          "overwrite": {"type": "boolean", "description": "命中同一 entry_id 时整条替换而非字段级合并，用于视图编辑"},
          "resolve_projects": {"type": "boolean", "description": "按项目登记表归一项目名，默认 true"},
          "register_projects": {"type": "boolean", "description": "自动登记未知名项目，默认 true"},
          "entries_step": {"type": "string"},
          "base_step": {"type": "string", "description": "上游确定性素材步骤；与 entries_step（AI 总结）配合时，工时/起止时间等以素材为准"},
          "workflow_context": {"type": "object", "additionalProperties": true},
          "entry": {
            "type": "object",
            "properties": {
              "entry_id": {"type": "string"},
              "date": {"type": "string"},
              "source": {"type": "string"},
              "session_id": {"type": "string"},
              "project": {"type": "string"},
              "feature": {"type": "string", "description": "功能/模块名，用于按项目下的功能归类与小计"},
              "exhibit": {"type": "string", "description": "展项名（项目下的具体展项），可留空"},
              "repo_path": {"type": "string", "description": "会话仓库根路径（稳定标识）；写入时据此归类到项目/展项，未命中则留空待认领"},
              "project_hint": {"type": "string", "description": "未归类时保留的原始项目名建议，仅作参考"},
              "category": {"type": "string", "enum": ["开发", "修复", "设计", "调研", "文档", "评审", "会议", "运维", "其他"], "description": "受控工作类型（中文枚举），未知值会被视为「其他」"},
              "minutes": {"type": "integer", "minimum": 0, "maximum": 1440, "description": "工时（分钟）"},
              "minutes_source": {"type": "string", "enum": ["measured", "span", "estimated", "manual"]},
              "started_at": {"type": "string"},
              "ended_at": {"type": "string"},
              "title": {"type": "string"},
              "summary": {"type": "string"},
              "outcomes": {"type": "array", "items": {"type": "string"}},
              "decisions": {"type": "array", "items": {"type": "string"}},
              "learnings": {"type": "array", "items": {"type": "string"}},
              "blockers": {"type": "array", "items": {"type": "string"}},
              "next": {"type": "array", "items": {"type": "string"}},
              "tags": {"type": "array", "items": {"type": "string"}},
              "refs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {"type": {"type": "string"}, "value": {"type": "string"}},
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "entry_id": {"type": "string"},
                "date": {"type": "string"},
                "source": {"type": "string"},
                "session_id": {"type": "string"},
                "project": {"type": "string"},
                "feature": {"type": "string", "description": "功能/模块名，用于按项目下的功能归类与小计"},
                "exhibit": {"type": "string", "description": "展项名（项目下的具体展项），可留空"},
              "repo_path": {"type": "string", "description": "会话仓库根路径（稳定标识）；写入时据此归类到项目/展项，未命中则留空待认领"},
              "project_hint": {"type": "string", "description": "未归类时保留的原始项目名建议，仅作参考"},
                "category": {"type": "string", "enum": ["开发", "修复", "设计", "调研", "文档", "评审", "会议", "运维", "其他"], "description": "受控工作类型（中文枚举），未知值会被视为「其他」"},
                "minutes": {"type": "integer", "minimum": 0, "maximum": 1440, "description": "工时（分钟）"},
                "minutes_source": {"type": "string", "enum": ["measured", "span", "estimated", "manual"]},
                "started_at": {"type": "string"},
                "ended_at": {"type": "string"},
                "title": {"type": "string"},
                "summary": {"type": "string"},
                "outcomes": {"type": "array", "items": {"type": "string"}},
                "decisions": {"type": "array", "items": {"type": "string"}},
                "learnings": {"type": "array", "items": {"type": "string"}},
                "blockers": {"type": "array", "items": {"type": "string"}},
                "next": {"type": "array", "items": {"type": "string"}},
                "tags": {"type": "array", "items": {"type": "string"}},
                "refs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {"type": {"type": "string"}, "value": {"type": "string"}},
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "local_write"
    },
    {
      "id": "work-log.entry.list",
      "description": "按日期区间、项目、分类、来源或标签查询日志",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "date": {"type": "string"},
          "from": {"type": "string"},
          "to": {"type": "string"},
          "project": {"type": "string"},
          "category": {"type": "string"},
          "source": {"type": "string"},
          "tag": {"type": "string"},
          "query": {"type": "string", "description": "自由文本检索：匹配标题/摘要/功能/项目/标签"},
          "limit": {"type": "integer", "minimum": 1, "maximum": 5000}
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "read_only"
    },
    {
      "id": "work-log.entry.read",
      "description": "读取某一天的日志条目",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "date": {"type": "string"}
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "read_only"
    },
    {
      "id": "work-log.entry.delete",
      "description": "删除某天日志中的指定条目；删空后移除当天文件，日历不再残留空白日期",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "date": {"type": "string"},
          "entry_id": {"type": "string"},
          "entry_ids": {"type": "array", "items": {"type": "string"}}
        },
        "required": ["date"],
        "additionalProperties": false
      },
      "risk_level": "local_write"
    },
    {
      "id": "work-log.archive.list",
      "description": "列出有日志的日期与已生成的报告，供视图浏览",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "date": {"type": "string"},
          "from": {"type": "string"},
          "to": {"type": "string"},
          "limit": {"type": "integer", "minimum": 1, "maximum": 2000}
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "read_only"
    },
    {
      "id": "work-log.archive.calendar",
      "description": "按月生成日历统计，标注每天日志数量与项目",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "date": {"type": "string"},
          "year": {"type": "integer"},
          "month": {"type": "integer"},
          "week_start": {"type": "string", "enum": ["monday", "sunday"]},
          "project": {"type": "string", "description": "只统计命中该项目的条目"}
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "read_only"
    },
    {
      "id": "work-log.project.list",
      "description": "列出项目登记表与条目统计，含路径映射、未归类项目名与待认领路径",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "status": {"type": "string", "enum": ["active", "archived"]},
          "include_stats": {"type": "boolean"}
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "read_only"
    },
    {
      "id": "work-log.project.upsert",
      "description": "新增或更新项目登记（名称、别名、描述、状态、颜色、路径映射）",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "project_id": {"type": "string"},
          "project_name": {"type": "string"},
          "aliases": {"type": "array", "items": {"type": "string"}},
          "description": {"type": "string"},
          "status": {"type": "string", "enum": ["active", "archived"]},
          "color": {"type": "string"},
          "paths": {
            "type": "array",
            "description": "整组替换项目的路径映射；空数组表示清空",
            "items": {
              "type": "object",
              "properties": {
                "path": {"type": "string"},
                "kind": {"type": "string"},
                "label": {"type": "string"},
                "source": {"type": "string"}
              },
              "required": ["path"],
              "additionalProperties": false
            }
          },
          "add_paths": {"type": "array", "description": "追加路径映射", "items": {"type": "object", "additionalProperties": false, "properties": {"path": {"type": "string"}, "kind": {"type": "string"}, "label": {"type": "string"}, "source": {"type": "string"}}, "required": ["path"]}},
          "remove_paths": {"type": "array", "description": "移除路径映射", "items": {"type": "string"}}
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "local_write"
    },
    {
      "id": "work-log.project.path.set",
      "description": "管理项目或展项的路径映射（路径是稳定标识）",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "project_id": {"type": "string"},
          "project_name": {"type": "string"},
          "exhibit_id": {"type": "string"},
          "exhibit_name": {"type": "string"},
          "paths": {
            "type": "array",
            "description": "整组替换；空数组表示清空",
            "items": {
              "type": "object",
              "properties": {
                "path": {"type": "string"},
                "kind": {"type": "string"},
                "label": {"type": "string"},
                "source": {"type": "string"}
              },
              "required": ["path"],
              "additionalProperties": false
            }
          },
          "add_paths": {"type": "array", "description": "追加路径映射", "items": {"type": "object", "additionalProperties": false, "properties": {"path": {"type": "string"}, "kind": {"type": "string"}, "label": {"type": "string"}, "source": {"type": "string"}}, "required": ["path"]}},
          "remove_paths": {"type": "array", "description": "移除路径映射", "items": {"type": "string"}}
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "local_write"
    },
    {
      "id": "work-log.project.mapPath",
      "description": "预览一个路径会命中哪个项目/展项（只读）",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "path": {"type": "string"},
          "repo_path": {"type": "string"}
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "read_only"
    },
    {
      "id": "work-log.project.claim",
      "description": "认领一个仓库路径到项目/展项，并回填历史条目",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "repo_path": {"type": "string", "description": "要认领的仓库/目录路径"},
          "project_id": {"type": "string"},
          "project_name": {"type": "string"},
          "exhibit_id": {"type": "string"},
          "exhibit_name": {"type": "string"},
          "create_target": {"type": "boolean", "description": "目标不存在时是否新建项目/展项，默认 true"}
        },
        "required": ["repo_path"],
        "additionalProperties": false
      },
      "risk_level": "local_write"
    },
    {
      "id": "work-log.project.merge",
      "description": "合并来源项目到目标项目（搬移条目并保留别名/路径/展项）",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "from_project": {"type": "string", "description": "单个来源项目"},
          "from_projects": {"type": "array", "items": {"type": "string"}, "description": "批量来源项目"},
          "to_project": {"type": "string"},
          "project_id": {"type": "string"},
          "project_name": {"type": "string"}
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "local_write"
    },
    {
      "id": "work-log.project.delete",
      "description": "按 ID 或名称删除项目登记，支持批量",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "project_id": {"type": "string"},
          "project_ids": {"type": "array", "items": {"type": "string"}, "description": "批量删除的项目 ID"},
          "project_name": {"type": "string"}
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "local_write"
    },
    {
      "id": "work-log.project.rename",
      "description": "修改项目展示名，并回绑历史条目到新名",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "project_id": {"type": "string"},
          "project_name": {"type": "string"},
          "new_name": {"type": "string", "description": "新的项目展示名"}
        },
        "required": ["new_name"],
        "additionalProperties": false
      },
      "risk_level": "local_write"
    },
    {
      "id": "work-log.project.autofill",
      "description": "从本机 AI 会话记录搜一轮，自动补全项目路径",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "material_root": {"type": "string", "description": "会话素材目录，缺省用采集器私有数据目录"},
          "dry_run": {"type": "boolean", "description": "只预览不写盘"}
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "local_write"
    },
    {
      "id": "work-log.project.export",
      "description": "导出完整项目登记表（含别名/路径/展项）为 JSON",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"}
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "read_only"
    },
    {
      "id": "work-log.project.import",
      "description": "导入项目登记表：merge 合并（默认）或 replace 替换",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "projects_json": {"type": "string", "description": "work-log.project.export 产出的 JSON 文本"},
          "mode": {"type": "string", "enum": ["merge", "replace"]}
        },
        "required": ["projects_json"],
        "additionalProperties": false
      },
      "risk_level": "local_write"
    },
    {
      "id": "work-log.entry.patch",
      "description": "对单条日志做字段级局部更新（只改传入的键）",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "date": {"type": "string", "description": "条目所属日期 YYYY-MM-DD"},
          "entry_id": {"type": "string"},
          "patch": {
            "type": "object",
            "description": "要修改的字段（project/feature/exhibit/category/title/summary/minutes/minutes_source/repo_path/tags）",
            "additionalProperties": true
          }
        },
        "required": ["date", "entry_id", "patch"],
        "additionalProperties": false
      },
      "risk_level": "local_write"
    },
    {
      "id": "work-log.archive.migrate",
      "description": "把登记表与日文件补齐到当前 schema（可 dry_run）",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "dry_run": {"type": "boolean"}
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "local_write"
    },
    {
      "id": "work-log.project.resolve",
      "description": "把一个原始项目名按登记表归一为规范项目名",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "project": {"type": "string"},
          "project_name": {"type": "string"}
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "read_only"
    },
    {
      "id": "work-log.project.assign",
      "description": "把一批已有条目重新归到目标项目，用于清理历史归类",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "project": {"type": "string"},
          "project_name": {"type": "string"},
          "from": {"type": "string"},
          "to": {"type": "string"},
          "date": {"type": "string"},
          "current_project": {"type": "string"},
          "source": {"type": "string"},
          "category": {"type": "string"},
          "tag": {"type": "string"},
          "session_id": {"type": "string"}
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "local_write"
    },
    {
      "id": "work-log.project.sync",
      "description": "把工作台项目（含展项与路径）并入本地项目登记表（项目看板同步入口）",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "projects": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
          "projects_step": {"type": "string"},
          "exhibits": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
          "exhibits_step": {"type": "string", "description": "上游展项列表步骤（含 source_path/release_path）"}
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "local_write"
    },
    {
      "id": "work-log.source.list",
      "description": "读取通用可配置来源（<日志根>/config/sources.json）",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {"log_root": {"type": "string"}},
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "read_only"
    },
    {
      "id": "work-log.source.save",
      "description": "保存通用可配置来源规格，供采集器读取",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "mode": {"type": "string", "enum": ["merge", "replace"]},
          "sources": {"type": "array", "items": {"type": "object", "additionalProperties": true}}
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "local_write"
    },
    {
      "id": "work-log.report.render",
      "description": "把区间日志聚合渲染为日、周、月、季度或年度报告并归档",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "period": {"type": "string", "enum": ["daily", "weekly", "monthly", "quarterly", "yearly"]},
          "date": {"type": "string"},
          "narrative": {"type": "string"},
          "narratives": {
            "type": "object",
            "additionalProperties": {"type": "string"},
            "description": "按项目或「项目/功能」的模型小结，键为项目名或 项目/功能"
          },
          "title": {"type": "string"},
          "narrative_step": {"type": "string"},
          "workflow_context": {"type": "object", "additionalProperties": true}
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "local_write"
    },
    {
      "id": "work-log.report.read",
      "description": "读取已生成的某周期报告 Markdown 与网页",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
