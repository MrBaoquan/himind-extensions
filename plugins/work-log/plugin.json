{
  "id": "com.himind.work-log",
  "name": "工作日志工具",
  "author": "马宝全",
  "categories": ["collaboration-delivery", "docs-knowledge"],
  "description": "以按日工作日志为核心：条目带项目/展项、功能与工时，默认精简可展开，按功能分组；报告按 项目→功能 聚合，项目登记表支持别名归一与看板同步。",
  "release_notes": "0.6.2：修复窄窗口横向溢出，提升弱化文字对比度与角标字号，补齐页签/月历无障碍语义与键盘焦点。",
  "version": "0.6.2",
  "distribution_targets": ["workbench", "github"],
  "entry": "bin/work-log.exe",
  "runtime": "process-jsonrpc-stdio",
  "platforms": ["windows-x64"],
  "min_agent_version": "0.3.0",
  "governance": "optional",
  "capabilities": [
    {
      "id": "work-log.entry.upsert",
      "description": "写入或合并某天的日志条目，按稳定 ID 幂等去重",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "date": {"type": "string"},
          "mode": {"type": "string", "enum": ["merge", "replace"]},
          "overwrite": {"type": "boolean", "description": "命中同一 entry_id 时整条替换而非字段级合并，用于视图编辑"},
          "resolve_projects": {"type": "boolean", "description": "按项目登记表归一项目名，默认 true"},
          "register_projects": {"type": "boolean", "description": "自动登记未知名项目，默认 true"},
          "entries_step": {"type": "string"},
          "base_step": {"type": "string", "description": "上游确定性素材步骤；与 entries_step（AI 总结）配合时，工时/起止时间等以素材为准"},
          "workflow_context": {"type": "object", "additionalProperties": true},
          "entry": {
            "type": "object",
            "properties": {
              "entry_id": {"type": "string"},
              "date": {"type": "string"},
              "source": {"type": "string"},
              "session_id": {"type": "string"},
              "project": {"type": "string"},
              "feature": {"type": "string", "description": "功能/模块名，用于按项目下的功能归类与小计"},
              "exhibit": {"type": "string", "description": "展项名（项目下的具体展项），可留空"},
              "category": {"type": "string", "enum": ["开发", "修复", "设计", "调研", "文档", "评审", "会议", "运维", "其他"], "description": "受控工作类型（中文枚举），未知值会被视为「其他」"},
              "minutes": {"type": "integer", "minimum": 0, "maximum": 1440, "description": "工时（分钟）"},
              "minutes_source": {"type": "string", "enum": ["measured", "span", "estimated", "manual"]},
              "started_at": {"type": "string"},
              "ended_at": {"type": "string"},
              "title": {"type": "string"},
              "summary": {"type": "string"},
              "outcomes": {"type": "array", "items": {"type": "string"}},
              "decisions": {"type": "array", "items": {"type": "string"}},
              "learnings": {"type": "array", "items": {"type": "string"}},
              "blockers": {"type": "array", "items": {"type": "string"}},
              "next": {"type": "array", "items": {"type": "string"}},
              "tags": {"type": "array", "items": {"type": "string"}},
              "refs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {"type": {"type": "string"}, "value": {"type": "string"}},
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "entry_id": {"type": "string"},
                "date": {"type": "string"},
                "source": {"type": "string"},
                "session_id": {"type": "string"},
                "project": {"type": "string"},
                "feature": {"type": "string", "description": "功能/模块名，用于按项目下的功能归类与小计"},
                "exhibit": {"type": "string", "description": "展项名（项目下的具体展项），可留空"},
                "category": {"type": "string", "enum": ["开发", "修复", "设计", "调研", "文档", "评审", "会议", "运维", "其他"], "description": "受控工作类型（中文枚举），未知值会被视为「其他」"},
                "minutes": {"type": "integer", "minimum": 0, "maximum": 1440, "description": "工时（分钟）"},
                "minutes_source": {"type": "string", "enum": ["measured", "span", "estimated", "manual"]},
                "started_at": {"type": "string"},
                "ended_at": {"type": "string"},
                "title": {"type": "string"},
                "summary": {"type": "string"},
                "outcomes": {"type": "array", "items": {"type": "string"}},
                "decisions": {"type": "array", "items": {"type": "string"}},
                "learnings": {"type": "array", "items": {"type": "string"}},
                "blockers": {"type": "array", "items": {"type": "string"}},
                "next": {"type": "array", "items": {"type": "string"}},
                "tags": {"type": "array", "items": {"type": "string"}},
                "refs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {"type": {"type": "string"}, "value": {"type": "string"}},
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "local_write"
    },
    {
      "id": "work-log.entry.list",
      "description": "按日期区间、项目、分类、来源或标签查询日志",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "date": {"type": "string"},
          "from": {"type": "string"},
          "to": {"type": "string"},
          "project": {"type": "string"},
          "category": {"type": "string"},
          "source": {"type": "string"},
          "tag": {"type": "string"},
          "query": {"type": "string", "description": "自由文本检索：匹配标题/摘要/功能/项目/标签"},
          "limit": {"type": "integer", "minimum": 1, "maximum": 5000}
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "read_only"
    },
    {
      "id": "work-log.entry.read",
      "description": "读取某一天的日志条目",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "date": {"type": "string"}
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "read_only"
    },
    {
      "id": "work-log.entry.delete",
      "description": "删除某天日志中的指定条目；删空后移除当天文件，日历不再残留空白日期",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "date": {"type": "string"},
          "entry_id": {"type": "string"},
          "entry_ids": {"type": "array", "items": {"type": "string"}}
        },
        "required": ["date"],
        "additionalProperties": false
      },
      "risk_level": "local_write"
    },
    {
      "id": "work-log.archive.list",
      "description": "列出有日志的日期与已生成的报告，供视图浏览",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "date": {"type": "string"},
          "from": {"type": "string"},
          "to": {"type": "string"},
          "limit": {"type": "integer", "minimum": 1, "maximum": 2000}
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "read_only"
    },
    {
      "id": "work-log.archive.calendar",
      "description": "按月生成日历统计，标注每天日志数量与项目",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "date": {"type": "string"},
          "year": {"type": "integer"},
          "month": {"type": "integer"},
          "week_start": {"type": "string", "enum": ["monday", "sunday"]},
          "project": {"type": "string", "description": "只统计命中该项目的条目"}
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "read_only"
    },
    {
      "id": "work-log.project.list",
      "description": "列出项目登记表与每个项目的条目统计，并给出未归类的原始项目名",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "status": {"type": "string", "enum": ["active", "archived"]},
          "include_stats": {"type": "boolean"}
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "read_only"
    },
    {
      "id": "work-log.project.upsert",
      "description": "新增或更新项目登记（名称、别名、描述、状态、颜色）",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "project_id": {"type": "string"},
          "project_name": {"type": "string"},
          "aliases": {"type": "array", "items": {"type": "string"}},
          "description": {"type": "string"},
          "status": {"type": "string", "enum": ["active", "archived"]},
          "color": {"type": "string"}
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "local_write"
    },
    {
      "id": "work-log.project.delete",
      "description": "按 ID 或名称删除项目登记（不影响既有条目）",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "project_id": {"type": "string"},
          "project_name": {"type": "string"}
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "local_write"
    },
    {
      "id": "work-log.project.resolve",
      "description": "把一个原始项目名按登记表归一为规范项目名",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "project": {"type": "string"},
          "project_name": {"type": "string"}
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "read_only"
    },
    {
      "id": "work-log.project.assign",
      "description": "把一批已有条目重新归到目标项目，用于清理历史归类",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "project": {"type": "string"},
          "project_name": {"type": "string"},
          "from": {"type": "string"},
          "to": {"type": "string"},
          "date": {"type": "string"},
          "current_project": {"type": "string"},
          "source": {"type": "string"},
          "category": {"type": "string"},
          "tag": {"type": "string"},
          "session_id": {"type": "string"}
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "local_write"
    },
    {
      "id": "work-log.project.sync",
      "description": "把工作台项目（含展项）并入本地项目登记表（项目看板同步入口）",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "projects": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
          "projects_step": {"type": "string"}
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "local_write"
    },
    {
      "id": "work-log.source.list",
      "description": "读取通用可配置来源（<日志根>/config/sources.json）",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {"log_root": {"type": "string"}},
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "read_only"
    },
    {
      "id": "work-log.source.save",
      "description": "保存通用可配置来源规格，供采集器读取",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "mode": {"type": "string", "enum": ["merge", "replace"]},
          "sources": {"type": "array", "items": {"type": "object", "additionalProperties": true}}
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "local_write"
    },
    {
      "id": "work-log.report.render",
      "description": "把区间日志聚合渲染为日、周、季度或年度报告并归档",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "period": {"type": "string", "enum": ["daily", "weekly", "quarterly", "yearly"]},
          "date": {"type": "string"},
          "narrative": {"type": "string"},
          "narratives": {
            "type": "object",
            "additionalProperties": {"type": "string"},
            "description": "按项目或「项目/功能」的模型小结，键为项目名或 项目/功能"
          },
          "title": {"type": "string"},
          "narrative_step": {"type": "string"},
          "workflow_context": {"type": "object", "additionalProperties": true}
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "local_write"
    },
    {
      "id": "work-log.report.read",
      "description": "读取已生成的某周期报告 Markdown 与网页",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "period": {"type": "string", "enum": ["daily", "weekly", "quarterly", "yearly"]},
          "date": {"type": "string"}
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "read_only"
    },
    {
      "id": "work-log.link.open",
      "description": "用系统默认程序打开引用链接",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {"url": {"type": "string"}},
        "required": ["url"],
        "additionalProperties": false
      },
      "risk_level": "local_action"
    },
    {
      "id": "work-log.link.reveal",
      "description": "在系统文件管理器中打开日志目录（或指定目录/文件）",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "path": {"type": "string", "description": "要定位的目录或文件；留空则打开日志根目录"}
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "local_action"
    }
  ],
  "permissions": ["filesystem.workspace.read", "filesystem.workspace.write"],
  "contributes": {
    "views": [
      {
        "id": "work-log.timeline",
        "title": "工作日志 · 日历回看",
        "short_title": "工作日志",
        "icon": "calendar",
        "quick_access": true,
        "order": 45,
        "location": "plugin_navigation",
        "entry": "ui/index.html"
      }
    ],
    "commands": [
      {"id": "work-log.entry.upsert", "title": "记录今日工作日志"},
      {"id": "work-log.entry.delete", "title": "删除工作日志条目"},
      {"id": "work-log.archive.calendar", "title": "按日历回看工作日志"},
      {"id": "work-log.report.render", "title": "生成当日工作简报"},
      {"id": "work-log.archive.list", "title": "浏览工作日志归档"},
      {"id": "work-log.project.list", "title": "查看项目归类"},
      {"id": "work-log.link.reveal", "title": "打开日志目录"}
    ]
  }
}
