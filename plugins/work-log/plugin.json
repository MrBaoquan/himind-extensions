{
  "id": "com.himind.work-log",
  "icon": "assets/icon.png",
  "name": "工作日志工具",
  "author": "马宝全",
  "categories": ["collaboration-delivery", "docs-knowledge"],
  "description": "以按日工作日志为核心，含当前工作台（项目状态、优先级、下一步、完成）、工作项、每日时间块计划与容量校验；按项目/功能/工时聚合报告，支持导出导入、备份恢复与重扫对账。",
  "release_notes": "0.16.0：季度总结与年度总结可设置起算月，公司按 2 月起算时 Q1 为 2、3、4 月；工时表支持按行复制为表格。",
  "version": "0.16.0",
  "capability_namespace": "work-log",
  "distribution_targets": ["workbench", "github"],
  "entry": "bin/work-log.exe",
  "runtime": "process-jsonrpc-stdio",
  "platforms": ["windows-x64"],
  "min_agent_version": "0.3.0",
  "governance": "optional",
  "capabilities": [
    {
      "id": "work-log.entry.upsert",
      "description": "写入或合并某天的日志条目，按稳定 ID 幂等去重",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "date": {"type": "string"},
          "overwrite": {"type": "boolean", "description": "命中同一 entry_id 时整条替换而非字段级合并，用于视图编辑"},
          "resolve_projects": {"type": "boolean", "description": "按项目登记表归一项目名，并为未命中的项目自动建项目，默认 true"},
          "register_projects": {"type": "boolean", "description": "已废弃字段，忽略；自动建项目统一由 resolve_projects 控制"},
          "entries_step": {"type": "string"},
          "base_step": {"type": "string", "description": "上游确定性素材步骤；与 entries_step（AI 总结）配合时，工时/起止时间等以素材为准"},
          "workflow_context": {"type": "object", "additionalProperties": true},
          "entry": {
            "type": "object",
            "properties": {
              "entry_id": {"type": "string"},
              "date": {"type": "string"},
              "source": {"type": "string"},
              "session_id": {"type": "string"},
              "project": {"type": "string"},
              "feature": {"type": "string", "description": "功能/模块名，用于按项目下的功能归类与小计"},
              "exhibit": {"type": "string", "description": "展项名（项目下的具体展项），可留空"},
              "repo_path": {"type": "string", "description": "会话仓库根路径（稳定标识）；写入时据此归类，未命中则按项目名/目录名自动建项目并登记该路径"},
              "project_hint": {"type": "string", "description": "未归类时保留的原始项目名建议，仅作参考"},
              "category": {"type": "string", "enum": ["开发", "修复", "设计", "调研", "文档", "评审", "会议", "运维", "其他"], "description": "受控工作类型（中文枚举），未知值会被视为「其他」"},
              "minutes": {"type": "integer", "minimum": 0, "maximum": 1440, "description": "工时（分钟）"},
              "minutes_source": {"type": "string", "enum": ["measured", "span", "estimated", "manual"]},
              "started_at": {"type": "string"},
              "ended_at": {"type": "string"},
              "title": {"type": "string"},
              "summary": {"type": "string"},
              "outcomes": {"type": "array", "items": {"type": "string"}},
              "decisions": {"type": "array", "items": {"type": "string"}},
              "learnings": {"type": "array", "items": {"type": "string"}},
              "blockers": {"type": "array", "items": {"type": "string"}},
              "next": {"type": "array", "items": {"type": "string"}},
              "tags": {"type": "array", "items": {"type": "string"}},
              "refs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {"type": {"type": "string"}, "value": {"type": "string"}},
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "entry_id": {"type": "string"},
                "date": {"type": "string"},
                "source": {"type": "string"},
                "session_id": {"type": "string"},
                "project": {"type": "string"},
                "feature": {"type": "string", "description": "功能/模块名，用于按项目下的功能归类与小计"},
                "exhibit": {"type": "string", "description": "展项名（项目下的具体展项），可留空"},
              "repo_path": {"type": "string", "description": "会话仓库根路径（稳定标识）；写入时据此归类，未命中则按项目名/目录名自动建项目并登记该路径"},
              "project_hint": {"type": "string", "description": "未归类时保留的原始项目名建议，仅作参考"},
                "category": {"type": "string", "enum": ["开发", "修复", "设计", "调研", "文档", "评审", "会议", "运维", "其他"], "description": "受控工作类型（中文枚举），未知值会被视为「其他」"},
                "minutes": {"type": "integer", "minimum": 0, "maximum": 1440, "description": "工时（分钟）"},
                "minutes_source": {"type": "string", "enum": ["measured", "span", "estimated", "manual"]},
                "started_at": {"type": "string"},
                "ended_at": {"type": "string"},
                "title": {"type": "string"},
                "summary": {"type": "string"},
                "outcomes": {"type": "array", "items": {"type": "string"}},
                "decisions": {"type": "array", "items": {"type": "string"}},
                "learnings": {"type": "array", "items": {"type": "string"}},
                "blockers": {"type": "array", "items": {"type": "string"}},
                "next": {"type": "array", "items": {"type": "string"}},
                "tags": {"type": "array", "items": {"type": "string"}},
                "refs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {"type": {"type": "string"}, "value": {"type": "string"}},
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "local_write"
    },
    {
      "id": "work-log.entry.list",
      "description": "按日期区间、项目、分类、来源或标签查询日志",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "date": {"type": "string"},
          "from": {"type": "string"},
          "to": {"type": "string"},
          "project": {"type": "string"},
          "category": {"type": "string"},
          "source": {"type": "string"},
          "tag": {"type": "string"},
          "query": {"type": "string", "description": "自由文本检索：匹配标题/摘要/功能/项目/标签"},
          "limit": {"type": "integer", "minimum": 1, "maximum": 5000}
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "read_only"
    },
    {
      "id": "work-log.entry.read",
      "description": "读取某一天的日志条目",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "date": {"type": "string"}
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "read_only"
    },
    {
      "id": "work-log.entry.delete",
      "description": "删除某天日志中的指定条目；删空后移除当天文件，日历不再残留空白日期",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "date": {"type": "string"},
          "entry_id": {"type": "string"},
          "entry_ids": {"type": "array", "items": {"type": "string"}}
        },
        "required": ["date"],
        "additionalProperties": false
      },
      "risk_level": "local_write"
    },
    {
      "id": "work-log.archive.list",
      "description": "列出有日志的日期与已生成的报告，供视图浏览",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "date": {"type": "string"},
          "from": {"type": "string"},
          "to": {"type": "string"},
          "limit": {"type": "integer", "minimum": 1, "maximum": 2000}
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "read_only"
    },
    {
      "id": "work-log.archive.calendar",
      "description": "按月生成日历统计，标注每天日志数量与项目",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "date": {"type": "string"},
          "year": {"type": "integer"},
          "month": {"type": "integer"},
          "week_start": {"type": "string", "enum": ["monday", "sunday"]},
          "project": {"type": "string", "description": "只统计命中该项目的条目"}
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "read_only"
    },
    {
      "id": "work-log.project.list",
      "description": "列出项目登记表与条目统计，含路径映射与未归类项目名",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "status": {"type": "string", "enum": ["active", "archived"]},
          "include_stats": {"type": "boolean"},
          "recent_days": {"type": "integer", "minimum": 1, "maximum": 365, "description": "当前工作的最近活动窗口，默认 14 天"}
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "read_only"
    },
    {
      "id": "work-log.project.board",
      "description": "当前工作台：项目状态、优先级、下一步、阻塞、最近活动与本周投入",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "recent_days": {"type": "integer", "minimum": 1, "maximum": 365, "description": "当前工作的最近活动窗口，默认 14 天"}
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "read_only"
    },
    {
      "id": "work-log.project.work.update",
      "description": "更新项目工作状态：状态、优先级、目标、目标日期、下一步、阻塞、完成摘要",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "project_id": {"type": "string"},
          "project_name": {"type": "string"},
          "project": {"type": "string"},
          "patch": {"type": "object", "additionalProperties": true}
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "local_write"
    },
    {
      "id": "work-log.item.list",
      "description": "列出工作项，可按项目、状态、优先级和关键词筛选",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "project": {"type": "string"},
          "status": {"type": "string"},
          "priority": {"type": "string"},
          "query": {"type": "string"},
          "include_done": {"type": "boolean"},
          "from": {"type": "string"},
          "to": {"type": "string"}
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "read_only"
    },
    {
      "id": "work-log.item.upsert",
      "description": "新增或更新一个工作项（预计耗时、剩余耗时、截止日期、优先级）",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "work_item": {"type": "object", "additionalProperties": true}
        },
        "required": ["work_item"],
        "additionalProperties": false
      },
      "risk_level": "local_write"
    },
    {
      "id": "work-log.item.update",
      "description": "字段级更新工作项：状态、预计/剩余耗时、优先级、截止日期等",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "work_item_id": {"type": "string"},
          "patch": {"type": "object", "additionalProperties": true}
        },
        "required": ["work_item_id", "patch"],
        "additionalProperties": false
      },
      "risk_level": "local_write"
    },
    {
      "id": "work-log.item.delete",
      "description": "删除一个或多个工作项",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "work_item_id": {"type": "string"},
          "work_item_ids": {"type": "array", "items": {"type": "string"}}
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "local_write"
    },
    {
      "id": "work-log.plan.get",
      "description": "读取某天的计划、时间块与容量",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "date": {"type": "string"}
        },
        "required": ["date"],
        "additionalProperties": false
      },
      "risk_level": "read_only"
    },
    {
      "id": "work-log.plan.save",
      "description": "保存某天的计划与时间块，校验重叠和容量",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "date": {"type": "string"},
          "plan": {"type": "object", "additionalProperties": true}
        },
        "required": ["plan"],
        "additionalProperties": false
      },
      "risk_level": "local_write"
    },
    {
      "id": "work-log.plan.auto",
      "description": "一键智能排期（仅当天）：根据当前/待开始项目、工作项优先级、截止日期与剩余耗时生成当日计划",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "date": {"type": "string"}
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "local_write"
    },
    {
      "id": "work-log.plan.validate",
      "description": "校验计划的时间块重叠、起止时间与容量，不写盘",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "plan": {"type": "object", "additionalProperties": true}
        },
        "required": ["plan"],
        "additionalProperties": false
      },
      "risk_level": "read_only"
    },
    {
      "id": "work-log.plan.review",
      "description": "按当日结束后的日志结算计划实际完成情况；当天返回 pending",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "date": {"type": "string"}
        },
        "required": ["date"],
        "additionalProperties": false
      },
      "risk_level": "read_only"
    },
    {
      "id": "work-log.plan.list",
      "description": "按日期区间读取计划摘要",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "from": {"type": "string"},
          "to": {"type": "string"}
        },
        "required": ["from", "to"],
        "additionalProperties": false
      },
      "risk_level": "read_only"
    },
    {
      "id": "work-log.project.upsert",
      "description": "新增或更新项目登记（名称、别名、描述、状态、颜色、路径映射）",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "project_id": {"type": "string"},
          "project_name": {"type": "string"},
          "aliases": {"type": "array", "items": {"type": "string"}},
          "description": {"type": "string"},
          "status": {"type": "string", "enum": ["active", "archived"]},
          "color": {"type": "string"},
          "kind": {"type": "string", "description": "项目类型：交付项目 / 平台产品 / 通用沉淀"},
          "paths": {
            "type": "array",
            "description": "整组替换项目的路径映射；空数组表示清空",
            "items": {
              "type": "object",
              "properties": {
                "path": {"type": "string"},
                "kind": {"type": "string"},
                "label": {"type": "string"},
                "source": {"type": "string"}
              },
              "required": ["path"],
              "additionalProperties": false
            }
          },
          "add_paths": {"type": "array", "description": "追加路径映射", "items": {"type": "object", "additionalProperties": false, "properties": {"path": {"type": "string"}, "kind": {"type": "string"}, "label": {"type": "string"}, "source": {"type": "string"}}, "required": ["path"]}},
          "remove_paths": {"type": "array", "description": "移除路径映射", "items": {"type": "string"}}
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "local_write"
    },
    {
      "id": "work-log.project.path.set",
      "description": "管理项目或展项的路径映射（路径是稳定标识）",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "project_id": {"type": "string"},
          "project_name": {"type": "string"},
          "exhibit_id": {"type": "string"},
          "exhibit_name": {"type": "string"},
          "paths": {
            "type": "array",
            "description": "整组替换；空数组表示清空",
            "items": {
              "type": "object",
              "properties": {
                "path": {"type": "string"},
                "kind": {"type": "string"},
                "label": {"type": "string"},
                "source": {"type": "string"}
              },
              "required": ["path"],
              "additionalProperties": false
            }
          },
          "add_paths": {"type": "array", "description": "追加路径映射", "items": {"type": "object", "additionalProperties": false, "properties": {"path": {"type": "string"}, "kind": {"type": "string"}, "label": {"type": "string"}, "source": {"type": "string"}}, "required": ["path"]}},
          "remove_paths": {"type": "array", "description": "移除路径映射", "items": {"type": "string"}}
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "local_write"
    },
    {
      "id": "work-log.project.path.map",
      "description": "预览一个路径会命中哪个项目/展项（只读）",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "path": {"type": "string"},
          "repo_path": {"type": "string"}
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "read_only"
    },
    {
      "id": "work-log.project.claim",
      "description": "把一个仓库路径归到项目/展项，并回填历史条目",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "repo_path": {"type": "string", "description": "要认领的仓库/目录路径"},
          "project_id": {"type": "string"},
          "project_name": {"type": "string"},
          "exhibit_id": {"type": "string"},
          "exhibit_name": {"type": "string"},
          "create_target": {"type": "boolean", "description": "目标不存在时是否新建项目/展项，默认 true"}
        },
        "required": ["repo_path"],
        "additionalProperties": false
      },
      "risk_level": "local_write"
    },
    {
      "id": "work-log.project.merge",
      "description": "合并来源项目到目标项目（搬移条目并保留别名/路径/展项）",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "from_project": {"type": "string", "description": "单个来源项目"},
          "from_projects": {"type": "array", "items": {"type": "string"}, "description": "批量来源项目"},
          "to_project": {"type": "string"},
          "project_id": {"type": "string"},
          "project_name": {"type": "string"}
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "local_write"
    },
    {
      "id": "work-log.project.delete",
      "description": "按 ID 或名称删除项目登记，支持批量",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "project_id": {"type": "string"},
          "project_ids": {"type": "array", "items": {"type": "string"}, "description": "批量删除的项目 ID"},
          "project_name": {"type": "string"}
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "local_write"
    },
    {
      "id": "work-log.project.rename",
      "description": "修改项目展示名，并回绑历史条目到新名",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
          "project_id": {"type": "string"},
          "project_name": {"type": "string"},
          "new_name": {"type": "string", "description": "新的项目展示名"}
        },
        "required": ["new_name"],
        "additionalProperties": false
      },
      "risk_level": "local_write"
    },
    {
      "id": "work-log.project.autofill",
      "description": "从本机 AI 会话记录搜一轮，自动补全项目路径",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "log_root": {"type": "string"},
