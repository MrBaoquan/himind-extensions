{
  "id": "com.himind.media-downloader",
  "name": "媒体下载工具",
  "author": "超级管理员",
  "categories": [
    "video-post",
    "audio-sound",
    "data-automation"
  ],
  "description": "把网页中的在线音视频、字幕和播放列表下载到系统下载文件夹或指定目录，并记录来源信息。",
  "release_notes": "0.2.2：修复搜索框嵌套边框与高度对齐，保持下载管理表格收敛。",
  "version": "0.2.2",
  "distribution_targets": [
    "workbench",
    "github"
  ],
  "entry": "bin/media-downloader.exe",
  "runtime": "process-jsonrpc-stdio",
  "platforms": [
    "windows-x64"
  ],
  "min_agent_version": "0.3.47",
  "governance": "optional",
  "capability_namespace": "media.downloader",
  "capabilities": [
    {
      "id": "media.downloader.runtime.status",
      "description": "检查 yt-dlp 与 ffmpeg 运行时状态",
      "availability": "local",
      "timeout_seconds": 20,
      "input_schema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "read_only"
    },
    {
      "id": "media.downloader.runtime.install",
      "description": "下载并安装固定版本的 yt-dlp 运行时",
      "availability": "local",
      "timeout_seconds": 600,
      "input_schema": {
        "type": "object",
        "properties": {
          "force": {
            "type": "boolean"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "local_write"
    },
    {
      "id": "media.downloader.info.get",
      "description": "解析媒体链接并返回格式、字幕与条目摘要",
      "availability": "local",
      "timeout_seconds": 90,
      "input_schema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2000
          },
          "playlist": {
            "type": "boolean"
          },
          "max_items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      },
      "risk_level": "read_only"
    },
    {
      "id": "media.downloader.job.start",
      "description": "创建受控下载任务并立即返回任务 ID",
      "availability": "local",
      "timeout_seconds": 30,
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace_root": {
            "type": "string",
            "maxLength": 1000
          },
          "url": {
            "type": "string",
            "maxLength": 2000
          },
          "dest_dir": {
            "type": "string",
            "maxLength": 1000
          },
          "format_id": {
            "type": "string",
            "maxLength": 200
          },
          "quality": {
            "enum": [
              "best",
              "1080p",
              "720p",
              "480p"
            ]
          },
          "audio_only": {
            "type": "boolean"
          },
          "subtitles": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "maxLength": 50
            }
          },
          "playlist": {
            "type": "boolean"
          },
          "max_items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "max_bytes": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 17179869184
          },
          "overwrite": {
            "type": "boolean"
          },
          "title": {
            "type": "string",
            "maxLength": 300
          },
          "thumbnail": {
            "type": "string",
            "maxLength": 2000
          },
          "extractor": {
            "type": "string",
            "maxLength": 100
          },
          "duration_seconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000
          }
        },
        "required": [
          "workspace_root",
          "url"
        ],
        "additionalProperties": false
      },
      "risk_level": "local_write"
    },
    {
      "id": "media.downloader.job.status",
      "description": "查询下载任务状态、进度与产物",
      "availability": "local",
      "timeout_seconds": 15,
      "input_schema": {
        "type": "object",
        "properties": {
          "job_id": {
            "type": "string",
            "maxLength": 64
          }
        },
        "required": [
          "job_id"
        ],
        "additionalProperties": false
      },
      "risk_level": "read_only"
    },
    {
      "id": "media.downloader.job.cancel",
      "description": "取消仍在执行的下载任务",
      "availability": "local",
      "timeout_seconds": 15,
      "input_schema": {
        "type": "object",
        "properties": {
          "job_id": {
            "type": "string",
            "maxLength": 64
          }
        },
        "required": [
          "job_id"
        ],
        "additionalProperties": false
      },
      "risk_level": "local_write"
    },
    {
      "id": "media.downloader.job.list",
      "description": "列出最近的下载任务",
      "availability": "local",
      "timeout_seconds": 15,
      "input_schema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "query": {
            "type": "string",
            "maxLength": 200
          },
          "statuses": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "string",
              "enum": [
                "queued",
                "running",
                "canceling",
                "completed",
                "failed",
                "canceled"
              ]
            }
          },
          "since": {
            "type": "string",
            "maxLength": 40
          },
          "until": {
            "type": "string",
            "maxLength": 40
          },
          "sort": {
            "type": "string",
            "enum": [
              "created_desc",
              "created_asc",
              "size_desc",
              "progress_desc",
              "title_asc"
            ]
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "read_only"
    },
    {
      "id": "media.downloader.job.retry",
      "description": "沿用原任务参数重新创建下载任务",
      "availability": "local",
      "timeout_seconds": 30,
      "input_schema": {
        "type": "object",
        "properties": {
          "job_id": {
            "type": "string",
            "maxLength": 64
          }
        },
        "required": [
          "job_id"
        ],
        "additionalProperties": false
      },
      "risk_level": "local_write"
    },
    {
      "id": "media.downloader.job.remove",
      "description": "删除已结束任务的记录与日志，不删除媒体文件",
      "availability": "local",
      "timeout_seconds": 15,
      "input_schema": {
        "type": "object",
        "properties": {
          "job_id": {
            "type": "string",
            "maxLength": 64
          }
        },
        "required": [
          "job_id"
        ],
        "additionalProperties": false
      },
      "risk_level": "local_write"
    },
    {
      "id": "media.downloader.job.cleanup",
      "description": "按受控条件批量清理已结束任务的记录与日志",
      "availability": "local",
      "timeout_seconds": 60,
      "input_schema": {
        "type": "object",
        "properties": {
          "statuses": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "string",
              "enum": [
                "completed",
                "failed",
                "canceled"
              ]
            }
          },
          "older_than_days": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3650
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "dry_run": {
            "type": "boolean"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "local_write"
    },
    {
      "id": "media.downloader.job.log",
      "description": "读取任务日志尾部用于诊断",
      "availability": "local",
      "timeout_seconds": 15,
      "input_schema": {
        "type": "object",
        "properties": {
          "job_id": {
            "type": "string",
            "maxLength": 64
          },
          "max_bytes": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 262144
          }
        },
        "required": [
          "job_id"
        ],
        "additionalProperties": false
      },
      "risk_level": "read_only"
    }
  ],
  "permissions": [
    "filesystem.workspace.read",
    "filesystem.workspace.write",
    "filesystem.downloads.write",
    "network.web.read",
    "network.package-registry",
    "process.media-tool",
    "process.python"
  ],
  "plugin_dependencies": [],
  "contributes": {
    "views": [
      {
        "id": "media.downloader.main",
        "title": "媒体下载工具",
        "short_title": "媒体下载",
        "icon": "download",
        "quick_access": true,
        "order": 61,
        "location": "plugin_navigation",
        "entry": "ui/download.html"
      }
    ],
    "commands": [
      {
        "id": "media.downloader.runtime.status",
        "title": "检查下载运行时"
      },
      {
        "id": "media.downloader.runtime.install",
        "title": "安装下载运行时"
      },
      {
        "id": "media.downloader.info.get",
        "title": "解析媒体链接"
      },
      {
        "id": "media.downloader.job.start",
        "title": "开始下载"
      },
      {
        "id": "media.downloader.job.status",
        "title": "查看下载任务"
      },
      {
        "id": "media.downloader.job.cancel",
        "title": "取消下载任务"
      },
      {
        "id": "media.downloader.job.cleanup",
        "title": "清理下载记录"
      }
    ]
  }
}
