{
  "id": "com.himind.tech-radar",
  "icon": "assets/icon.png",
  "name": "开源热榜",
  "author": "马宝全",
  "categories": [
    "data-automation",
    "docs-knowledge"
  ],
  "description": "按定时计划中的采集组采集公开开源仓库，比较历史热度，生成可归档的网页报告。",
  "release_notes": "0.6.5：归档期次按日期合并；期次统计排除旧版兼容报告，全部视图去重展示。",
  "version": "0.6.5",
  "distribution_targets": [
    "workbench",
    "github"
  ],
  "entry": "bin/tech-radar.exe",
  "runtime": "process-jsonrpc-stdio",
  "platforms": [
    "windows-x64"
  ],
  "min_agent_version": "0.3.80",
  "governance": "optional",
  "capabilities": [
    {
      "id": "tech-radar.collect",
      "description": "按定时计划内采集组的标签采集公开仓库，用历史快照计算星数增量",
      "availability": "local",
      "timeout_seconds": 300,
      "input_schema": {
        "type": "object",
        "properties": {
          "domains": {
            "type": "array",
            "items": {
              "enum": [
                "cv",
                "llm",
                "ar-vr",
                "general",
                "ai-short-drama",
                "ai-video",
                "code-animation",
                "creator-tools"
              ]
            }
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,49}$"
            }
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exclude_owners": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "min_stars": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200000
          },
          "new_min_stars": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200000
          },
          "query_interval_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 60000
          },
          "max_queries": {
            "type": "integer",
            "minimum": 1,
            "maximum": 40,
            "default": 24
          },
          "max_entries": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "description_max_chars": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2000
          },
          "topics_max": {
            "type": "integer",
            "minimum": 0,
            "maximum": 50
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 30,
            "maximum": 1800
          },
          "window_days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 90
          },
          "top_n": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "report_root": {
            "type": "string"
          },
          "report_date": {
            "type": "string"
          },
          "category_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "extra_topics": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,49}$"
            }
          },
          "interest_groups": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string",
                  "maxLength": 40
                },
                "topics": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 12,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]{0,49}$"
                  }
                }
              },
              "required": [
                "name",
                "topics"
              ],
              "additionalProperties": true
            }
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "read_only"
    },
    {
      "id": "tech-radar.themes",
      "description": "读取标签库、starter groups、查询预算与自定义 topic 规则",
      "availability": "local",
      "timeout_seconds": 5,
      "input_schema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "read_only"
    },
    {
      "id": "tech-radar.report",
      "description": "把热点快照（与可选解读）渲染为自包含网页报告并按天归档",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "snapshot": {
            "type": "object"
          },
          "insight": {
            "type": "object"
          },
          "report_root": {
            "type": "string"
          },
          "report_date": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "workflow_context": {
            "type": "object"
          },
          "snapshot_step": {
            "type": "string"
          },
          "insight_step": {
            "type": "string"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "local_write"
    },
    {
      "id": "tech-radar.archive.list",
      "description": "读取扩展自己的归档索引，供视图列出历史报告并按日期筛选",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "report_root": {
            "type": "string"
          },
          "report_date": {
            "type": "string"
          },
          "top_n": {
            "type": "integer",
            "minimum": 1,
            "maximum": 365
          },
          "collection_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "read_only"
    },
    {
      "id": "tech-radar.archive.read",
      "description": "读取某期归档报告的 HTML、快照与解读",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "report_root": {
            "type": "string"
          },
          "report_date": {
            "type": "string"
          },
          "collection_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "read_only"
    },
    {
      "id": "tech-radar.link.open",
      "description": "用系统默认程序打开条目链接",
      "availability": "local",
      "input_schema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      },
      "risk_level": "local_action"
    },
    {
      "id": "tech-radar.categories.save",
      "description": "兼容旧版计划：创建或更新用户分类及其标签",
      "availability": "local",
      "timeout_seconds": 5,
      "input_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "description": {
            "type": "string",
            "maxLength": 200
          },
          "topics": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,49}$"
            }
          },
          "custom_tags": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "slug": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,49}$"
                },
                "label": {
                  "type": "string",
                  "maxLength": 40
                },
                "source": {
                  "type": "string"
                }
              },
              "required": [
                "slug"
              ]
            }
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "label",
          "topics"
        ],
        "additionalProperties": false
      },
      "risk_level": "local_write"
    },
    {
      "id": "tech-radar.categories.delete",
      "description": "兼容旧版计划：删除未被计划引用的用户分类；内置分类只读",
      "availability": "local",
      "timeout_seconds": 5,
      "input_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "risk_level": "local_write"
    },
    {
      "id": "tech-radar.catalog",
      "description": "读取丰富标签库、starter groups、查询预算和自定义 topic 规则",
      "availability": "local",
      "timeout_seconds": 5,
      "input_schema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "risk_level": "read_only"
    }
  ],
  "permissions": [
    "filesystem.workspace.read",
    "filesystem.workspace.write",
    "network.github.read"
  ],
  "contributes": {
    "views": [
      {
        "id": "tech-radar.archive",
        "title": "开源热榜 · 历史归档",
        "short_title": "开源热榜",
        "icon": "radar",
        "quick_access": true,
        "order": 40,
        "location": "plugin_navigation",
        "entry": "ui/index.html"
      }
    ],
    "commands": [
      {
        "id": "tech-radar.collect",
        "title": "采集开源热榜热点"
      },
      {
        "id": "tech-radar.report",
        "title": "生成开源热榜报告"
      },
      {
        "id": "tech-radar.archive.list",
        "title": "查看开源热榜归档"
      },
      {
        "id": "tech-radar.archive.read",
        "title": "查看某一期开源热榜报告"
      },
      {
        "id": "tech-radar.link.open",
        "title": "在默认浏览器打开条目链接"
      }
    ]
  }
}
