# Build outputs
bin/
dist/
out/
*.exe
*.pdb
*.hmpkg
*.hmskill
*.hmwf
extension-lock.json
*.release-manifest.json
checksums.sha256

# Local state
# Agent 在工作区生成的媒体、下载任务和临时状态，不属于扩展源码。
/.himind-data/
/.himind-downloads/
/.himind-media/
/.himind-temp/
/.himind/media-toolkit/
/.himind/video-cover/
/.himind/ui-diagnostics/
/.himind/workbench-cover-e2e-out/
/.himind/workbench-cover-e2e-ui-out/
# 工作流从 style-packs 模板生成的本机执行工程；可复用模板仍保留在源码仓。
/code-projects/
# 插件辅助工具的本机编译缓存。
/plugins/*/tools/.cache/
# 本机 Agent 的媒体产物（生图/生视频落盘），属于运行期本地状态，不进扩展仓。
.himind/media/
# 工作流会话素材（采集器在扩展私有目录不可写时改写到 <工作区>/.himind/material），运行期本地状态。
.himind/material/
# 长任务驱动的跨会话状态，属于本机运行状态。
.himind/long-tasks/
# Skill 工作区同步生成的各客户端投影目录，不进入扩展源码仓。
skills/*/.agents/
skills/*/.claude/
skills/*/.cline/
skills/*/.codebuddy/
skills/*/.cursor/
skills/*/.gemini/
skills/*/.github/
skills/*/.himind/
skills/*/.kiro/
skills/*/.opencode/
skills/*/.workbuddy/
skills/*/.zcode/
# 媒体下载插件的默认输出目录（运行期本地产物）。只锚定仓库根目录：插件内部的 internal/media 源码包不能被这条规则吞掉。
/media/
.idea/
.vscode/
.DS_Store
Thumbs.db
*.log
*.tmp
.himind-candidate-*
.himind-video/
node_modules/

# Credentials and environment files
.env
.env.*
!.env.example

# PS7 迁移时留下的本机环境备份（PATH、PowerShell 路径、MCP 管道名），不进入扩展源码仓。
.ps7-migration-backup/

# 本机手工快照（插件/技能移除前的一次性归档，含二进制），属于本机状态，不进入扩展源码仓。
# 需要长期留存的源码应走 Git 历史或独立的备份仓，不在这里堆压缩包。
backups/
